<odoo>
    <record id="hr_equipment_view_form_tlab" model="ir.ui.view">
        <field name="name">equipment.form.tlab</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='product_information']//field[@name='warranty_date']" position="after">
                <field name="location_id"/>
            </xpath>
            <xpath expr="//field[@name='location']" position="replace"/>
        </field>
    </record>

    <record id="hr_equipment_location_view_form_tlab" model="ir.ui.view">
        <field name="name">equipment.location.form</field>
        <field name="model">maintenance.equipment.location</field>
        <field name="arch" type="xml">
            <form string="Equipment Locations">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Location Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <br/>
                    <field name="note" string="Comment"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_equipment_location_view_tree_tlab" model="ir.ui.view">
        <field name="name">equipment.location.tree</field>
        <field name="model">maintenance.equipment.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Name"/>
                <field name="note" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="hr_equipment_location_action_tlab" model="ir.actions.act_window">
        <field name="name">Equipment Locations</field>
        <field name="res_model">maintenance.equipment.location</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="tlab_maintenance.hr_equipment_location_view_tree_tlab"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new equipment location
            </p>
        </field>
    </record>

    <menuitem
            id="menu_maintenance_location"
            name="Equipment Locations"
            parent="maintenance.menu_maintenance_configuration"
            action="tlab_maintenance.hr_equipment_location_action_tlab"
            sequence="3"/>
</odoo>
