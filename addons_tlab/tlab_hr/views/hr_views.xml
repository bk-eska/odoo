<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="employee_skill_view_tree_tlab" model="ir.ui.view">
        <field name="name">hr.skill.tree.tlab</field>
        <field name="model">hr.skill</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skill_type_id']" position="after">
                <field name="education_duration"/>
                <field name="education_place"/>
                <field name="educator"/>
                <field name="evaluation_score"/>
            </xpath>
        </field>
    </record>


    <record id="employee_skill_view_form_tlab" model="ir.ui.view">
        <field name="name">hr.employees.skill.form.tlab</field>
        <field name="model">hr.employee.skill</field>
        <field name="inherit_id" ref="hr_skills.employee_skill_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label" position="before">
                <field name="education_duration"/>
                <field name="education_place"/>
                <field name="educator"/>
                <field name="evaluation_score"/>
            </xpath>
        </field>
    </record>


    <record id="hr_skill_view_form_tlab" model="ir.ui.view">
        <field name="name">hr.skill.form.tlab</field>
        <field name="model">hr.skill</field>
        <field name="inherit_id" ref="hr_skills.hr_skill_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skill_type_id']" position="after">
                <field name="education_duration"/>
                <field name="education_place"/>
                <field name="educator"/>
                <field name="evaluation_score"/>
            </xpath>
        </field>
    </record>
</odoo>
