<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_skill_report_view_pivot_tlab" model="ir.ui.view">
        <field name="name">hr.employee.skill.report.view.pivot.tlab</field>
        <field name="model">hr.employee.skill.report</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_skill_report_view_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='level_progress']" position="after">
                <field name="education_duration" type="measure"/>
                <field name="education_place"/>
                <field name="educator"/>
                <field name="evaluation_score" type="measure"/>
            </xpath>
        </field>
    </record>

   <record id="hr_employee_skill_report_view_list_tlab" model="ir.ui.view">
        <field name="name">hr.employee.skill.report.view.list.tlab</field>
        <field name="model">hr.employee.skill.report</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_skill_report_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='level_progress']" position="after">
                <field name="education_duration"/>
                <field name="education_place"/>
                <field name="educator"/>
                <field name="evaluation_score"/>
            </xpath>
        </field>
    </record>
</odoo>
