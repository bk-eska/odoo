<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_inherit_purchase_credit" model="ir.ui.view">
        <field name="name">account.move.inherit.purchase.credit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fiscal_position_id']" position="after">
                <field name="purchase_id" class="oe_edit_only"
                    invisible="1" context="{'show_total_amount': True}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="after">
                <field name="purchase_line_id" invisible="1" readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>