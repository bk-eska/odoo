<odoo>
    <record model="ir.ui.view" id="view_move_form_currency_rate">
        <field name="name">account.move.form.currency.rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']/field[@name='currency_id']" position="after">
                <span class="oe_inline o_form_label mx-3"
                      groups="base.group_multi_currency"
                      attrs="{'invisible': [('move_type', '=', 'entry')]}"> </span>
                <button name="%(action_account_convert_currency)d"
                            type="action"
                            class="oe_inline oe_link"
                            string="(convert)"
                            attrs="{'invisible':['|', ('state','!=','draft'),
                            ('move_type','not in', ['out_invoice', 'out_refund', 'in_refund', 'in_invoice'])]}"/>
            </xpath>
            <xpath expr="//div[@name='journal_div']/field[@name='currency_id']/.."
                   position="after">
                <field name="use_currency_rate" invisible="1"/>
                <field name="use_currency_rate_method" invisible="1"/>
                <label for="currency_rate"
                       groups="base.group_multi_currency"
                       attrs="{'invisible':[('use_currency_rate','=',False)]}"/>
                <div groups="base.group_multi_currency"
                     class="d-flex"
                     attrs="{'invisible':[('use_currency_rate','=',False)]}">
                    <field name="currency_rate_method"
                           groups="base.group_multi_currency"
                           attrs="{'invisible':[('use_currency_rate_method','=',False)],
                           'readonly':[('state','!=','draft')]}"/>
                    <span class="oe_inline o_form_label mx-3 oe_read_only"
                          attrs="{'invisible':[('use_currency_rate_method','=',False)]}"
                          groups="base.group_multi_currency"> </span>
                    <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only"
                          attrs="{'invisible':[('use_currency_rate_method','=',False)]}"
                          groups="base.group_multi_currency"> </span>
                    <field name="use_inverse_rate" invisible="1"/>
                    <field name="currency_rate"
                           nolabel="1"
                           class="oe_inline"
                           attrs="{'invisible': [('use_inverse_rate','=',True)]}"/>
                    <field name="currency_inverse_rate"
                           nolabel="1"
                           class="oe_inline"
                           attrs="{'invisible': [('use_inverse_rate','=',False)]}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='amount_residual']" position="after">
                <field name="amount_total_signed"
                       sum="Total"
                       string="Total (Company Currency)"
                       widget="monetary"
                       attrs="{'invisible':[('use_currency_rate','=',False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
