<odoo>
    <record model="ir.ui.view" id="view_account_payment_form_currency_rate">
        <field name="name">account.payment.form.currency.rate</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']/.."
                   position="after">
                <field name="company_currency_id"
                       invisible="1"/>
                <field name="use_currency_rate"
                       invisible="1"/>
                <field name="use_currency_rate_method"
                       invisible="1"/>
                <label for="currency_rate"
                       groups="base.group_multi_currency"
                       attrs="{'invisible':[('use_currency_rate','=',False)]}"/>
                <div groups="base.group_multi_currency"
                     class="d-flex"
                     attrs="{'invisible':[('use_currency_rate','=',False)]}">
                    <field name="currency_rate_method"
                           groups="base.group_multi_currency"
                           attrs="{'invisible':['|',
                           ('use_currency_rate','=',False),
                           ('use_currency_rate_method','=',False)],
                           'readonly':[('state','!=','draft')]}"/>
                    <span class="oe_inline o_form_label mx-3 oe_read_only"
                          attrs="{'invisible':['|',
                           ('use_currency_rate','=',False),
                           ('use_currency_rate_method','=',False)]}"
                          groups="base.group_multi_currency"> </span>
                    <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only"
                          attrs="{'invisible':['|',
                           ('use_currency_rate','=',False),
                           ('use_currency_rate_method','=',False)]}"
                          groups="base.group_multi_currency"> </span>
                    <field name="use_inverse_rate" invisible="1"/>
                    <field name="currency_rate"
                           nolabel="1"
                           class="oe_inline"
                           attrs="{'invisible':[('use_inverse_rate','=',True)]}"/>
                    <field name="currency_inverse_rate"
                           nolabel="1"
                           class="oe_inline"
                           attrs="{'invisible':[('use_inverse_rate','=',False)]}"/>
                </div>
                <field name="amount_company_currency"
                       groups="base.group_multi_currency"
                       attrs="{'invisible':[('use_currency_rate','=',False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>




