<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form_currency_rate">
        <field name="name">res.config.settings.currency.rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='main_currency']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="currency_rate_display">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="show_currency_rate_selection"/>
                        <div class="text-muted">
                            Show Currency rate
                        </div>
                        <div class="mt16">
                            <field name="show_currency_rate_selection" class="o_light_label" widget="radio"/>
                            <field name="group_show_currency_rate_normal" invisible="1"/>
                            <field name="group_show_currency_rate_inverse" invisible="1"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
