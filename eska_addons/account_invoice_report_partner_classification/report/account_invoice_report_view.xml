<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_invoice_report_classification" model="ir.ui.view">
        <field name="name">account.invoice.report.classification</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='user']" position="after">
                <filter
                    string="Classification"
                    name="partner_classification"
                    context="{'group_by':'partner_classification_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>