<odoo>

    <record id="account_expense_group_form" model="ir.ui.view">
        <field name="name">account.expense.group.form</field>
        <field name="model">account.expense.group</field>
        <field name="arch" type="xml">
            <form string="Expense Group">
                <sheet>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_expense_group_tree" model="ir.ui.view">
        <field name="name">account.expense.group.tree</field>
        <field name="model">account.expense.group</field>
        <field name="arch" type="xml">
            <tree string="Expense Groups">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"  groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="account_expense_group_action" model="ir.actions.act_window">
        <field name="name">Expense Groups</field>
        <field name="res_model">account.expense.group</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="account_expense_group_tree"/>
    </record>

    <menuitem id="expense_group_menu"
              name="Expense Groups"
              parent="account.account_management_menu"
              action="account_expense_group_action"
              groups="account.group_account_manager"
              sequence="4"/>

</odoo>
