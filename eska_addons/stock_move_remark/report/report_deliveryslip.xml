<odoo>
    <template id="report_delivery_document_remark"
              inherit_id="stock.report_delivery_document">
        <xpath expr="//th[@name='th_sm_product']" position="after">
            <th name="th_sm_remark">
                <strong>Remark</strong>
            </th>
        </xpath>
        <xpath expr="//span[@t-field='move.product_id']/parent::td" position="after">
            <td>
                <span t-field="move.remark"/>
            </td>
        </xpath>
    </template>
</odoo>
