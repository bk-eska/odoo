<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_category_property_form_inherit_sequence" model="ir.ui.view">
        <field name="name">product.category.form.inherit.sequence</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="internal_reference_seq_id"
                       domain="[('code', '=', 'product.internal.sequence')]"
                       context="{'default_code': 'product.internal.sequence',
                           'default_padding': 8,
                           'default_implementation': 'no_gap'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
