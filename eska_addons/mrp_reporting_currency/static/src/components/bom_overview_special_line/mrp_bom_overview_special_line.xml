<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mrp_reporting_currency.BomOverviewSpecialLine" t-inherit="mrp.BomOverviewSpecialLine" t-inherit-mode="extension" owl="1">
        <xpath expr="//td[@name='bom_cost']" position="after">
            <td name="report_bom_cost" t-if="showCosts" class="text-end">
                <span t-if="props.type == 'operations'" t-esc="formatReportMonetary(data.report_operations_cost)"/>
                <span t-elif="props.type == 'byproducts'" t-esc="formatReportMonetary(data.report_byproducts_cost)"/>
            </td>
        </xpath>

        <xpath expr="//td[@name='prod_cost']" position="after">
            <td name="report_prod_cost" t-if="showCosts" class="text-end"/>
        </xpath>
    </t>
</templates>