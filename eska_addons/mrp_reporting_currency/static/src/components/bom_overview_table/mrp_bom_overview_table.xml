<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mrp_reporting_currency.BomOverviewTable" t-inherit="mrp.BomOverviewTable" t-inherit-mode="extension" owl="1">
        <xpath expr="//th[contains(text(), 'BoM Cost')]" position="after">
            <th t-if="showCosts"
                class="text-end"
                title="This is the currency cost based on the BoM of the product.
                It is computed by summing the costs of the components and operations needed to build the product.">
                BoM Currency Cost
            </th>
        </xpath>
        <xpath expr="//th[contains(text(), 'Product Cost')]" position="after">
            <th t-if="showCosts"
                class="text-end"
                title="This is the currency cost defined on the product.">
                Product Currency Cost
            </th>
        </xpath>

        <xpath expr="//td[@t-esc=&quot;formatMonetary(data.bom_cost / data.quantity)&quot;]" position="after">
            <td class="text-end" t-esc="formatReportMonetary(data.report_bom_cost / data.quantity)"/>
        </xpath>
        <xpath expr="//td[@t-esc=&quot;formatMonetary(data.prod_cost / data.quantity)&quot;]" position="after">
            <td class="text-end" t-esc="formatReportMonetary(data.report_prod_cost / data.quantity)"/>
        </xpath>

        <xpath expr="//td[@t-esc=&quot;formatMonetary(byproduct.bom_cost / byproduct.quantity)&quot;]" position="after">
            <td class="text-end" t-esc="formatReportMonetary(byproduct.report_bom_cost / byproduct.quantity)"/>
        </xpath>
        <xpath expr="//td[@t-esc=&quot;formatMonetary(byproduct.prod_cost / byproduct.quantity)&quot;]" position="after">
            <td class="text-end" t-esc="formatReportMonetary(byproduct.report_prod_cost / byproduct.quantity)"/>
        </xpath>
    </t>
</templates>