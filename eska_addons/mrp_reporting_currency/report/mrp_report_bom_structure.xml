<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_mrp_bom_reporting_currency" inherit_id="mrp.report_mrp_bom">
        <xpath expr="//t[@t-set='currency']" position="after">
            <t t-set="report_currency" t-value="data['report_currency']"/>
        </xpath>
        <xpath expr="//th[contains(text(), 'BoM Cost')]" position="after">
            <th t-if="data['show_costs']" class="text-end">BoM Currency Cost</th>
        </xpath>
        <xpath expr="//th[contains(text(), 'Product Cost')]" position="after">
            <th t-if="data['show_costs']" class="text-end">Product Currency Cost</th>
        </xpath>
        <xpath expr="//td[@t-if=&quot;data['show_costs']&quot;][1]" position="after">
            <td t-if="data['show_costs']"
                class="text-end" t-esc="data['report_bom_cost']"
                t-options='{"widget": "monetary", "display_currency": report_currency}'/>
        </xpath>
        <xpath expr="//td[@t-if=&quot;data['show_costs']&quot;][3]" position="after">
            <td t-if="data['show_costs']"
                class="text-end" t-esc="data['report_prod_cost']"
                t-options='{"widget": "monetary", "display_currency": report_currency}'/>
        </xpath>
        <xpath expr="//td[@t-esc=&quot;data['bom_cost'] / data['quantity']&quot;]" position="after">
            <td class="text-end"
                t-esc="data['report_bom_cost'] / data['quantity']"
                t-options='{"widget": "monetary", "display_currency": report_currency}'/>
        </xpath>
        <xpath expr="//td[@t-esc=&quot;data['prod_cost']/data['quantity']&quot;]" position="after">
            <td class="text-end"
                t-esc="data['report_prod_cost'] / data['quantity']"
                t-options='{"widget": "monetary", "display_currency": report_currency}'/>
        </xpath>
        <xpath expr="//td[@t-esc=&quot;byproduct['bom_cost'] / byproduct['quantity']&quot;]" position="after">
            <td class="text-end"
                t-esc="byproduct['bom_cost'] / byproduct['quantity']"
                t-options='{"widget": "monetary", "display_currency": report_currency}'/>
        </xpath>
        <xpath expr="//td[@t-esc=&quot;byproduct['prod_cost'] / byproduct['quantity']&quot;]" position="after">
            <td class="text-end"
                t-esc="byproduct['prod_cost'] / byproduct['quantity']"
                t-options='{"widget": "monetary", "display_currency": report_currency}'/>
        </xpath>
    </template>

    <template id="report_mrp_bom_pdf_line_reporting_currency" inherit_id="mrp.report_mrp_bom_pdf_line">
        <xpath expr="//t[@t-set='currency']" position="after">
            <t t-set="report_currency" t-value="data['report_currency']"/>
        </xpath>
        <xpath expr="//td[@t-esc=&quot;l['bom_cost']&quot;]" position="after">
            <td t-if="data['show_costs']"
                t-attf-class="text-end {{ 'text-muted' if l['type'] == 'component' else '' }}"
                t-esc="l['report_bom_cost']"
                t-options='{"widget": "monetary", "display_currency": report_currency}'/>
        </xpath>
        <xpath expr="//span[@t-esc=&quot;l['prod_cost']&quot;]/parent::td" position="after">
            <td t-if="data['show_costs']" class="text-end">
                <span t-if="'report_prod_cost' in l"
                      t-esc="l['report_prod_cost']"
                      t-options='{"widget": "monetary", "display_currency": report_currency}'/>
            </td>
        </xpath>
    </template>
</odoo>