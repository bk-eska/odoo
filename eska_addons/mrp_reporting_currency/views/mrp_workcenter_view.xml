<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_workcenter_inherit_reporting_currency" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.reporting.currency</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='costing']" position="replace">
                <group string="Costing Information" name="costing">
                    <field name="report_currency_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <label for="report_currency_costs_hour"/>
                    <div id="costs_hour" name="report_currency_costs_hour">
                        <field name="report_currency_costs_hour" widget="monetary" options="{'currency_field': 'report_currency_id'}" class="oe_inline"/> per workcenter
                    </div>
                    <label for="costs_hour"/>
                    <div id="costs_hour">
                        <field name="costs_hour" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline"/> per workcenter
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
