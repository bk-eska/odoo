<odoo>

    <record id="view_move_form_total_qty" model="ir.ui.view">
        <field name="name">account.move.form.total.qty</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_residual']"
                   position="after">
                <field name="total_qty"/>
            </xpath>
        </field>
    </record>

</odoo>
