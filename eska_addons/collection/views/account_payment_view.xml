<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_payment_form_document" model="ir.ui.view">
        <field name="name">account.payment.form.document</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="document" filename="filename"/>
                <field name="filename" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="payment_deposit" model="ir.actions.act_window">
        <field name="name">Deposit</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">collection.deposit.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="payment_transfer" model="ir.actions.act_window">
        <field name="name">Transfer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">collection.transfer.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>