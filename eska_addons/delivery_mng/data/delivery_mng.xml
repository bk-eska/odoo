<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="product_product_delivery_mng" model="product.product">
          <field name="name">MNG Kargo</field>
          <field name="type">service</field>
          <field name="categ_id" ref="delivery.product_category_deliveries"/>
          <field name="sale_ok" eval="False"/>
          <field name="purchase_ok" eval="False"/>
          <field name="list_price">0.0</field>
        </record>

        <record id="mng_packaging_MNG_DOSYA" model="stock.package.type">
            <field name="name">MNG DOSYA</field>
            <field name="shipper_package_code">1</field>
            <field name="package_carrier_type">mng</field>
        </record>
        <record id="mng_packaging_MNG_MI" model="stock.package.type">
            <field name="name">MNG Mİ</field>
            <field name="shipper_package_code">2</field>
            <field name="package_carrier_type">mng</field>
        </record>
        <record id="mng_packaging_MNG_PAKET" model="stock.package.type">
            <field name="name">MNG PAKET</field>
            <field name="shipper_package_code">3</field>
            <field name="package_carrier_type">mng</field>
        </record>
        <record id="mng_packaging_MNG_KOLI" model="stock.package.type">
            <field name="name">MNG KOLİ</field>
            <field name="shipper_package_code">4</field>
            <field name="package_carrier_type">mng</field>
        </record>

        <record id="delivery_carrier_mng" model="delivery.carrier">
            <field name="name">MNG Kargo</field>
            <field name="product_id" ref="delivery_mng.product_product_delivery_mng"/>
            <field name="delivery_type">mng</field>
            <field name="country_ids" eval="[(6, 0, [ref('base.in')])]"/>
            <field name="mng_default_package_type_id" ref="delivery_mng.mng_packaging_MNG_PAKET"/>
        </record>

    </data>
</odoo>
