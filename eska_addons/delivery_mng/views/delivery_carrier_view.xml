<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_with_provider_dhl" model="ir.ui.view">
        <field name="name">delivery.carrier.form.provider.dhl</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position='before'>
                <page string="MNG Kargo Configuration" name="mng_configuration"
                     attrs="{'invisible': [('delivery_type', '!=', 'mng')]}">
                    <group>
                        <group>
                            <field name="mng_api_key"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                            <field name="mng_secret"
                                   password="True"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                            <field name="mng_username"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                            <field name="mng_password"
                                   password="True"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                        </group>
                        <group>
                            <field name="mng_default_package_type_id"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}" domain="[('package_carrier_type', '=', 'mng')]"/>
                            <field name="mng_service_type"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                            <field name="mng_sms1"/>
                            <field name="mng_sms2"/>
                            <field name="mng_sms3"/>
                            <field name="mng_payment_type"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                            <field name="mng_pickup_type"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                            <field name="mng_delivery_type"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                            <field name="mng_delivery_type"
                                   attrs="{'required': [('delivery_type', '=', 'mng')]}"/>
                            <field name="mng_is_cod"/>
                        </group>
                        <group string="Options">
                            <field name="can_generate_return" invisible="1"/>
                            <field name="return_label_on_delivery"
                                   attrs="{'invisible': [('can_generate_return', '=', False)]}"/>
                            <field name="get_return_label_from_portal"
                                   attrs="{'invisible': [('return_label_on_delivery', '=', False)]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
