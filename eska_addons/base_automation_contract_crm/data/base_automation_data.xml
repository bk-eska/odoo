<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="contract_crm_automated_action" model="base.automation">
        <field name="name">Contract CRM Creation</field>
        <field name="model_id" ref="contract.model_contract_contract"/>
        <field name="trigger">on_time</field>
        <field name="trg_date_id" ref="contract.field_contract_contract__date_end"/>
        <field name="trg_date_range">-7</field>
        <field name="trg_date_range_type">day</field>
        <field name="state">code</field>
        <field name="code">
env['crm.lead'].create({
    'name': record.partner_id.name + ' CRM Lead',
    'partner_id': record.partner_id.id,
    'type': 'lead',
    'contract_id': record.id,
})
        </field>
    </record>
</odoo>
