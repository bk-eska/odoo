<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_crm_case_opportunities_filter_contract" model="ir.ui.view">
        <field name="name">crm.case.opportunities.filter.inherit.contract</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='saleschannel']" position="after">
                <filter string="Contract"
                        name="contract"
                        context="{'group_by':'contract_id'}" />
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_inherit_contract" model="ir.ui.view">
        <field name="name">crm.lead.view.form.route.id</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='opportunity_partner']//field[@name='partner_id']" position="after">
                <field name="contract_id"/>
            </xpath>
            <xpath expr="//group[@name='lead_partner']//field[@name='partner_id']" position="after">
                <field name="contract_id"/>
            </xpath>
        </field>
    </record>
</odoo>