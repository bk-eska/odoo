<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_otto" model="ir.ui.view">
        <field name="name">res.company.form.otto</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="before">
                <field name="otto_enabled"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Otto"
                      attrs="{'invisible':[('otto_enabled', '=', False)]}">
                    <group>
                        <group>
                            <field name="otto_api_url"/>
                            <field name="otto_username"/>
                            <field name="otto_password"/>
                        </group>
                        <group>
                            <field name="otto_token"/>
                            <field name="otto_token_last_refresh"/>
                            <field name="otto_last_so_check"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>