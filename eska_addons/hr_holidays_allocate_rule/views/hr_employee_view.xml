<odoo>
    <record id="hr_employee_view_form_auto_allocate_leave" model="ir.ui.view">
        <field name="name">hr.employee.view.form.auto.allocate.leave</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_holidays.view_employee_form_leave_inherit"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='hr_settings']/group" position="inside">
                    <group string="Time Off Allocation" name="remaining_date_group">
                        <field name="auto_allocate_leave" groups="hr_holidays.group_hr_holidays_manager"/>
                    </group>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
