<odoo>
    <record model="ir.ui.view" id="view_hr_holidays_allocate_rule_tree">
        <field name="name">hr.holidays.allocate.rule.tree</field>
        <field name="model">hr.holidays.allocate.rule</field>
        <field name="arch" type="xml">
            <tree string="Allocate Rule">
                <field name="name"/>
                <field name="priority"/>
                <field name="category_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="employee_id"/>
                <field name="younger_than"/>
                <field name="older_than"/>
                <field name="seniority_years"/>
                <field name="leave_type_id"/>
                <field name="number_of_days"/>
                <field name="active"/>
                <field name="auto_approve"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_hr_holidays_allocate_rule_form">
        <field name="name">hr.holidays.allocate.rule.form</field>
        <field name="model">hr.holidays.allocate.rule</field>
        <field name="arch" type="xml">
            <form string="Allocate Rule">
                <sheet string="Allocate Rule">
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="priority"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <group>
                        <group string="Criteria">
                            <field name="seniority_years"/>
                            <field name="younger_than"/>
                            <field name="older_than"/>
                            <field name="employee_id"/>
                            <field name="category_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                        </group>
                        <group string="Allocation">
                            <field name="leave_type_id" domain="[('requires_allocation', '=', 'yes')]"/>
                            <field name="number_of_days"/>
                            <field name="auto_approve"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_hr_holidays_allocate_rules">
        <field name="name">Time Off Allocate Rules</field>
        <field name="res_model">hr.holidays.allocate.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref=""/>
        <field name="view_id" ref="view_hr_holidays_allocate_rule_tree"/>
    </record>

    <menuitem id="menu_holidays_allocate_rules"
              parent="hr_holidays.menu_hr_holidays_configuration" sequence="10"
              action="action_hr_holidays_allocate_rules"
              groups="base.group_system"/>

</odoo>
