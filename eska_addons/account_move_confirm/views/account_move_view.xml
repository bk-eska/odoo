<odoo>
    <record id="account_move_form_inherit_confirm" model="ir.ui.view">
        <field name="name">account.move.form.confirm</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post'][1]"
                   position="attributes">
                <attribute name="confirm">Validate?</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][2]"
                   position="attributes">
