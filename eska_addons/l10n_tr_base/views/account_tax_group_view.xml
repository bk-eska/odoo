<odoo>
    <record id="view_tax_group_tree_code" model="ir.ui.view">
        <field name="name">account.tax.group.tree.code</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="l10n_tr_tax_type"/>
            </xpath>
        </field>
    </record>
        <record id="view_tax_group_form_code" model="ir.ui.view">
        <field name="name">account.tax.group.form.code</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="after">
                <field name="l10n_tr_tax_type"/>
            </xpath>
        </field>
    </record>
</odoo>
