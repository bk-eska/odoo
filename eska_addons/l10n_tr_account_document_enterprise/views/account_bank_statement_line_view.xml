<odoo>
    <record id="view_bank_statement_line_tree_bank_rec_widget_document"
            model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.bank_rec_widget.document</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id"
               ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible': [('l10n_tr_use_document', '=', False)],
                       'readonly': [('is_reconciled', '=', True),('amount', '!=', 0)]}"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_bank_statement_line_form_bank_rec_widget_document"
            model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.bank_rec_widget.document</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id"
               ref="account_accountant.view_bank_statement_line_form_bank_rec_widget"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible': [('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
