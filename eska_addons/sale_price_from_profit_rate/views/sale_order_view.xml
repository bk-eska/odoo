<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_price_calculation" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.price.calculation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="before">
                <button name="%(sale_calculate_price_wizard_action)d"
                        string="Calculate Price"
                        type="action"
                        states="draft,sent"
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
