<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_price_from_profit" model="ir.ui.view">
        <field name="name">product.template.form.price.from.profit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="after">
                 <group string="Profit" name="profit">
                     <field name="profit_rate"/>
                 </group>
             </xpath>
        </field>
    </record>
</odoo>
