<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_calculate_price_wizard_form" model="ir.ui.view">
        <field name="name">sale.calculate.price.wizard.form</field>
        <field name="model">sale.calculate.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Calculate Price">
                <group>
                    <field name="order_line" invisible="1"/>
                    <field name="generate_type" widget="radio"/>
                    <field name="profit_rate"
                           attrs="{'invisible': [('generate_type', '!=', 'manual')],
                                   'required': [('generate_type', '=', 'manual')]}"/>
                </group>
                <footer>
                    <button name="action_calculate_price"
                            string="Calculate"
                            class="oe_highlight"
                            type="object"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_calculate_price_wizard_action" model="ir.actions.act_window">
        <field name="name">Calculate Price</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.calculate.price.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_calculate_price_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="sale_calculate_price_wizard_action_line" model="ir.actions.act_window">
        <field name="name">Calculate Price</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.calculate.price.wizard</field>
        <field name="binding_model_id" ref="sale.model_sale_order_line"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_calculate_price_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>