<odoo>
    <record id="view_account_journal_form_document" model="ir.ui.view">
        <field name="name">account.journal.form.document</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_cash_payment_type"
                       attrs="{'invisible':['|',
                       ('l10n_tr_use_document', '=', False),
                       ('type','!=', 'cash')],
                       'required':[('l10n_tr_use_document', '=', True),
                       ('type','=', 'cash')]}"/>
                <field name="l10n_tr_bank_payment_type"
                       attrs="{'invisible':['|',
                       ('l10n_tr_use_document', '=', False),
                       ('type','!=', 'bank')],
                       'required':[('l10n_tr_use_document', '=', True),
                       ('type','=', 'bank')]}"/>
            </xpath>
        </field>
    </record>
</odoo>




