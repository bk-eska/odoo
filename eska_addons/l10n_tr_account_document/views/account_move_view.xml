<odoo>
    <record id="view_move_form_document" model="ir.ui.view">
        <field name="name">account.move.form.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible':['|', ('l10n_tr_use_document', '=', False),
                       '&amp;', ('move_type', '=', 'entry'), ('l10n_tr_document_type','=',False)],
                       'required':[('l10n_tr_document_type','!=',False)]}"/>
                <field name="l10n_tr_document_type"
                       attrs="{'invisible':['|', ('l10n_tr_use_document', '=', False), ('move_type', '!=', 'entry')]}"/>
                <field name="l10n_tr_document_type_description"
                       attrs="{'invisible':['|', '|', ('l10n_tr_use_document', '=', False), ('move_type', '!=', 'entry'), ('l10n_tr_document_type','!=','other')],
                       'required':[('l10n_tr_use_document', '=', True), ('l10n_tr_document_type','=','other')]}"/>
                <field name="l10n_tr_invoice_type"
                       attrs="{'invisible':['|', ('l10n_tr_use_document', '=', False), ('move_type','=','entry')]}"/>
                <field name="l10n_tr_delivery_type"
                       attrs="{'invisible':['|', ('l10n_tr_use_document', '=', False), ('move_type', '=', 'entry')],
                        'required':[('l10n_tr_use_document', '=', True), ('move_type', '!=', 'entry')]}"/>
                <field name="l10n_tr_payment_type"
                       string="Payment Type"
                       attrs="{'invisible':['|', ('l10n_tr_use_document', '=', False), ('l10n_tr_payment_type','=',False)]}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="l10n_tr_document_date"
                       attrs="{'invisible':['|', '|', ('l10n_tr_use_document', '=', False), ('move_type', '!=', 'entry'),  ('l10n_tr_document_type','=',False)],
                       'required':[('l10n_tr_document_type','!=',False), ('move_type','=','entry')]}"/>
            </xpath>
            <xpath expr="//field[@name='payment_reference']"
                   position="attributes">
                <attribute name="attrs">{'invisible':[('l10n_tr_use_document',
                    '=', True)]}
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="vview_move_tree_document" model="ir.ui.view">
        <field name="name">account.move.tree.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_tr_document_number"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_account_move_filter_document">
        <field name="name">account.move.select.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">
                    ['|', '|', '|',
                    ('name', 'ilike', self),
                    ('ref','ilike',self),
                    ('l10n_tr_document_number','ilike',self),
                    ('partner_id', 'ilike', self)]
                </attribute>
            </xpath>
            <group>
                <filter string="Document Type"
                        name="l10n_tr_document_type"
                        context="{'group_by':'l10n_tr_document_type'}"/>
            </group>
        </field>
    </record>

    <record id="view_invoice_tree_document" model="ir.ui.view">
        <field name="name">account.invoice.tree.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_tr_document_number"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_account_invoice_filter_document">
        <field name="name">account.invoice.select.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">[
                    '|', '|', '|', '|', '|',
                    ('name', 'ilike', self),
                    ('invoice_origin', 'ilike', self),
                    ('ref', 'ilike', self),
                    ('payment_reference', 'ilike', self),
                    ('l10n_tr_document_number', 'ilike', self),
                    ('partner_id', 'child_of', self)]
                </attribute>
            </xpath>
        </field>
    </record>

</odoo>
