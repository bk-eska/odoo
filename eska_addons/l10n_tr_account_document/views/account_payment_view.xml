<odoo>
    <record id="view_account_payment_tree_document" model="ir.ui.view">
        <field name="name">account.payment.tree.document</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_tr_document_number" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_document" model="ir.ui.view">
        <field name="name">account.payment.search.document</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='name']" position="attributes">
                  <attribute name="filter_domain">[
                      '|', '|', '|',
                      ('name', 'ilike', self),
                      ('partner_id', 'ilike', self),
                      ('l10n_tr_document_number', 'ilike', self),
                      ('ref', 'ilike', self) ]
                  </attribute>
              </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_document" model="ir.ui.view">
        <field name="name">account.payment.form.document</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible':[('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>




