<odoo>
    <record id="view_account_payment_register_form_document" model="ir.ui.view">
        <field name="name">account.payment.register.form.document</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id"
               ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible':[('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>




