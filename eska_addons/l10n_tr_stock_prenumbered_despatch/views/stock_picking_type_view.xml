<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_type_form_inherit_despatch" model="ir.ui.view">
        <field name="name">stock.picking.type.inherit.despatch</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='stock_picking_type_lot']" position="after">
                <group string="Printed Despatch Sequence"
                       attrs="{'invisible':['|', ('l10n_tr_use_document', '=', False),('code', '=', 'incoming')]}">
                    <field name="l10n_tr_despatch_number_sequence"
                       domain="[('code', '=', 'stock.picking'),
                       ('company_id', '=', company_id)]"
                       attrs="{'required':[('l10n_tr_despatch_auto_number','=',True),('l10n_tr_use_document', '=', True)]}"
                       context="{'default_code': 'stock.picking',
                       'default_padding': 6,
                       'default_implementation': 'no_gap',
                       'default_prefix': 'IRS'}"/>
                    <field name="l10n_tr_despatch_auto_number"/>
                    <field name="l10n_tr_use_document" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
