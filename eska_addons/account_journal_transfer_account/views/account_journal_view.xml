<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_journal_form_transfer_account" model="ir.ui.view">
        <field name="name">account.journal.form.transfer.account</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='loss_account_id']" position="after">
                <field name="transfer_account_id"
                       context="{'default_account_type': 'asset_current', 'default_reconcile': True}"
                       attrs="{'invisible': [('type', 'not in', ('cash', 'bank'))]}"/>
            </xpath>
        </field>
    </record>
</odoo>