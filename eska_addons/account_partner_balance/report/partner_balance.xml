<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_print_report_partner_balance_qweb" model="ir.actions.report">
        <field name="name">Partner Balance</field>
        <field name="model">partner.balance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_partner_balance.partner_balance</field>
        <field name="report_file">account_partner_balance.partner_balance</field>
        <field name="paperformat_id" ref="account_financial_report.report_qweb_paperformat" />
    </record>

    <record id="action_print_report_partner_balance_html" model="ir.actions.report">
        <field name="name">Partner Balance</field>
        <field name="model">partner.balance.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">account_partner_balance.partner_balance</field>
        <field name="report_file">account_partner_balance.partner_balance</field>
    </record>

    <record id="action_report_partner_balance_xlsx" model="ir.actions.report">
        <field name="name">Partner Balance XLSX</field>
        <field name="model">partner.balance.report.wizard</field>
        <field name="type">ir.actions.report</field>
        <field name="report_name">account_partner_balance.report_partner_balance_xlsx</field>
        <field name="report_type">xlsx</field>
        <field name="report_file">report_partner_balance</field>
    </record>

    <record id="action_report_partner_balance" model="ir.actions.client">
        <field name="name">Partner Balance</field>
        <field name="tag">account_financial_report_backend</field>
        <field
            name="context"
            eval="{'model': 'report.account_partner_balance.partner_balance'}"
        />
    </record>

</odoo>
