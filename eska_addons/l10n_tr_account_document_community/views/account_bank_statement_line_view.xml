<odoo>
    <record id="account_bank_statement_line_tree_document"
            model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.document</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id"
               ref="account_statement_base.account_bank_statement_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible': [('l10n_tr_use_document', '=', False)]}"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="account_bank_statement_line_form_document" model="ir.ui.view">
        <field name="name">account.bank.statement.line.document</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id"
               ref="account_statement_base.account_bank_statement_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible': [('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>
    <record id="bank_statement_line_form_add_view_document" model="ir.ui.view">
        <field name="name">account.bank.statement.line.document</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id"
               ref="account_reconcile_oca.bank_statement_line_form_add_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                           attrs="{'invisible': [('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>
    <record id="bank_statement_line_reconcile_view_document" model="ir.ui.view">
        <field name="name">account.bank.statement.line.document</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id"
               ref="account_reconcile_oca.bank_statement_line_reconcile_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']/.." position="before">
                <div>
                    <field name="l10n_tr_use_document" invisible="1"/>
                    <field name="l10n_tr_document_number"
                           attrs="{'invisible': ['|',
                           ('l10n_tr_use_document', '=', False),
                           ('l10n_tr_document_number', '=', False)]}"/>
                </div>
            </xpath>
        </field>
    </record>
    <!-- Gerektiğinde eklenecek manual_?
    <record id="bank_statement_line_form_reconcile_view_document" model="ir.ui.view">
        <field name="name">account.bank.statement.line.document</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id"
               ref="account_reconcile_oca.bank_statement_line_form_reconcile_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible': [('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>
    -->
</odoo>
