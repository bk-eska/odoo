<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_order_filter_route" model="ir.ui.view">
        <field name="name">purchase.order.search.route</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='vendor']" position="after">
                <filter name="route" string="Route" domain="[]" context="{'group_by':'partner_route_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_route_id" model="ir.ui.view">
        <field name="name">purchase.order.form.route.id</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_route_id"/>
            </xpath>
        </field>
    </record>
</odoo>