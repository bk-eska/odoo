<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_country_state_county_form_inherit">
        <field name="name">view_country_state_county_form2</field>
        <field name="model">res.county</field>
        <field name="inherit_id" ref="base_county.view_country_state_county_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_id']" position="after">
                <field name="better_zip_ids"
                       context="{'state_id': state_id}"
                       colspan="4"
                       nolabel="1">
                    <tree editable="top">
                        <field name="name"/>
                        <field name="city_id"/>
                        <field name="state_id"/>
                        <field name="country_id"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
