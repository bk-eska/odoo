<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="better_zip_tree_inherit">
        <field name="name">res.city.zip.tree</field>
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.city_zip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='city_id']" position="before">
                <field name="county_id"/>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="better_zip_form_inherit">
        <field name="name">res.city.zip</field>
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.city_zip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='city_id']" position="before">
                <field name="county_id"/>
            </xpath>
        </field>
    </record>
</odoo>
