<odoo>
    <record id="view_employee_form_analytic" model="ir.ui.view">
        <field name="name">hr.employee.view.form.analytic</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']/group" position="inside">
                <group string="Analytic Account" name="analytic_account_group">
                    <field name="analytic_account_id"
                           groups="analytic.group_analytic_accounting"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
