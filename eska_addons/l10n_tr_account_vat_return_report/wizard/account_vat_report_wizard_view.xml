<odoo>
    <record id="view_account_vat_report_wizard_form" model="ir.ui.view">
        <field name="name">account.vat.report.wizard.form</field>
        <field name="model">account.vat.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Account VAT Return Report">
                <group>
                    <field name="date_range_id" widget="date_range"/>
                </group>
                <footer>
                    <button name="generate_report"
                            string="Export Report"
                            class="oe_highlight fa fa-download"
                            type="object"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_vat_report_wizard" model="ir.actions.act_window">
        <field name="name">Account VAT Return Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.vat.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_tr_account_vat_return_report.view_account_vat_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
            parent="account.menu_finance_reports"
            id="menu_purchase_vat_report"
            name="Audit Reports"
            groups="account.group_account_user"
    />
    <menuitem
            parent="menu_purchase_vat_report"
            action="l10n_tr_account_vat_return_report.action_account_vat_report_wizard"
            id="menu_purchase_vat_report_wizard"
            sequence="10"
    />
</odoo>