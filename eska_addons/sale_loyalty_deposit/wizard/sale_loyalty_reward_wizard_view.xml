<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_loyalty_reward_wizard_view_form_deposit" model="ir.ui.view">
        <field name="name">sale.loyalty.reward.wizard.view.form.deposit</field>
        <field name="model">sale.loyalty.reward.wizard</field>
        <field name="inherit_id" ref="sale_loyalty.sale_loyalty_reward_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_apply']" position="after">
                <button type="object"
                        name="action_apply_all"
                        string="Apply All"
                        class="btn btn-primary"
                        attrs="{'invisible': [('reward_ids', '=', [])]}"/>
            </xpath>
        </field>
    </record>
</odoo>