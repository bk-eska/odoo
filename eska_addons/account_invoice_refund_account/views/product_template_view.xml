<odoo>
    <record id="product_template_in_out_refund_account" model="ir.ui.view">
        <field name="name">product.template.in.out.refund.account"</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_income_id']" position="after">
                <field name="property_account_out_refund_id"/>
            </xpath>
            <xpath expr="//field[@name='property_account_expense_id']" position="after">
                <field name="property_account_in_refund_id"/>
            </xpath>
        </field>
    </record>
</odoo>

