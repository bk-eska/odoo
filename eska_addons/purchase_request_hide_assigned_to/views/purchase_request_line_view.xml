<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_request_line_tree_hide_assigned" model="ir.ui.view">
        <field name="name">purchase.request.line.tree.hide.assigned</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id"
               ref="purchase_request.purchase_request_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="purchase_request_line_form_hide_assigned" model="ir.ui.view">
        <field name="name">purchase.request.line.form.hide.assigned</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id"
               ref="purchase_request.purchase_request_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="purchase_request_line_search_hide_assigned" model="ir.ui.view">
        <field name="name">purchase.request.line.search.hide.assigned</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id"
               ref="purchase_request.purchase_request_line_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='assigned_to']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='assigned_to_me']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='assigned_to']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
