<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_form_hide_assigned" model="ir.ui.view">
        <field name="name">purchase.request.form.hide.assigned</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id"
               ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_request_search_hide_assigned" model="ir.ui.view">
        <field name="name">purchase.request.search.hide.assigned</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id"
               ref="purchase_request.view_purchase_request_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='unassigned']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='assigned_to_me']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='assigned_to']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='assigned_to']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
