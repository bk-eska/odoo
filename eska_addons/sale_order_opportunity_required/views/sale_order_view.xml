<odoo>
    <record model="ir.ui.view" id="sale_order_form_opportunity_required">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_crm.sale_view_inherit123"/>
        <field name="arch" type="xml">
            <xpath expr="//group//field[@name='opportunity_id']" position="after">
                <field name="opportunity_required" invisible="1"/>
            </xpath>
            <xpath expr="//group//field[@name='opportunity_id']" position="attributes">
                <attribute name="attrs">{'required':[('opportunity_required', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
