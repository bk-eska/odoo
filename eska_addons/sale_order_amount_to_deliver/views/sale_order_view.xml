<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_tree_inherit_amount_to_deliver" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.amount.to.deliver</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field
                    name="amount_to_deliver"
                    string="To Deliver"
                    attrs="{'invisible': [('state', '!=', 'sale')]}"
                    optional="hide"
                    sum="To Deliver"
                />
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_amount_to_deliver" model="ir.ui.view">
        <field name="name">sale.quotation.tree.inherit.amount.to.deliver</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field
                    name="amount_to_deliver"
                    string="To Deliver"
                    attrs="{'invisible': [('state', '!=', 'sale')]}"
                    optional="hide"
                    sum="To Deliver"
                />
            </xpath>
        </field>
    </record>
</odoo>
