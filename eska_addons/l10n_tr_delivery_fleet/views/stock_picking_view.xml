<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="name">delivery.stock.picking_withcarrier.form.simple.package</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="l10n_tr_delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_tr_vehicle_license_plate']" position="before">
                <field name="l10n_tr_vehicle_id"
                       attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}"
                />
            </xpath>
            <xpath expr="//field[@name='l10n_tr_trailer_plate_no']" position="before">
                <field name="l10n_tr_trailer_id"
                       attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
