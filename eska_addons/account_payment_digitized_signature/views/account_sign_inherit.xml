<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<!-- Inherit to account.payment form view -->
<record id="inherit_sign_button_to_invoice" model="ir.ui.view">
    <field name="name">account.invoice.form.inherit</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
        <xpath expr="//form//header" position="inside">
            <widget name="signature"
                    string="Sign"
                    attrs="{'invisible':['|',('signature','!=',False), ('state','=','posted')]}"
                    full_name="partner_id"
            />
            <button name="action_account_unsign"
                    string="Unsign"
                    type="object"
                    attrs="{'invisible':['|',('signature','=',False), ('state','=','posted')]}"
            />
        </xpath>
        <xpath expr="//group[@name='group2']" position="inside">
            <field name="signature"
                   widget="signature"
            />
        </xpath>
    </field>
</record>


</odoo>