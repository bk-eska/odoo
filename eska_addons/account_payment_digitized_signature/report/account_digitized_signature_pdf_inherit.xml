<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="account_digitized_signature_pdf_inherit" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//table" position="after">
            <span t-if="o.signature">
                <div class="row mt-5">
                    <div t-if="o.signature" name="signature">
                        <div class="offset-10">
                            <strong>Payment signed by </strong>
                            <span t-field="o.partner_id.name"/>
                        </div>
                        <div class="offset-9">
                            <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                        </div>
                    </div>
                </div>
            </span>
        </xpath>
    </template>
</odoo>