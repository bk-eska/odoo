<odoo>
    <record id="t_report_xml_view_router" model="ir.ui.view">
        <field name="name">ir.actions.report.router</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced']" position="after">
                <page string="Routes">
                    <field name="route_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="parent_id" invisible="1"/>
                            <field name="model" invisible="1"/>
                            <field name="sequence"/>
                            <field name="report_id"
                                   domain="[('model','=',model),('id','!=',parent_id)]"/>
                            <field name="filter_id"
                                   domain="[('model_id','=',model)]"
                                   context="{'default_model_id': model,
                                   'default_user_id': False}"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

