<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.warehouse.relocate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="replace">
                <group name="relocate">
                    <field name="expected_date"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="after">
                <group name="sale_shipping">
                    <label for="commitment_date" string="Delivery Date"/>
                    <div name="commitment_date_div" class="o_row">
                        <field name="commitment_date"/>
                        <span name="expected_date_span" class="text-muted">Expected:
                            <field name="expected_date" widget="date"/>
                            <field name="show_json_popover" invisible="1"/>
                            <field string=" " name="json_popover" widget="stock_rescheduling_popover" attrs="{'invisible': [('show_json_popover', '=', False)]}"/>
                        </span>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.warehouse.relocate2</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='relocate']" position="replace"/>
        </field>
    </record>
</odoo>
