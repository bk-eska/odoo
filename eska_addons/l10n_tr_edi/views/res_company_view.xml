<odoo>
    <record id="view_company_form_edi" model="ir.ui.view">
        <field name="name">res.company.form.einvoice</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="E-Transition"
                      attrs="{'invisible':[('l10n_tr_use_document', '=', False)]}">
                    <group>
                        <group>
                            <field name="l10n_tr_edi_environment"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
