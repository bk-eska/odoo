<odoo>
    <record id="view_move_form_prenumbered" model="ir.ui.view">
        <field name="name">account.move.form.prenumbered</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_invoice_sent']"
                   position="before">
                <button name="action_assign_number"
                        type="object"
                        string="Assign Number"
                        attrs="{'invisible':['|', '|', '|', '|', ('l10n_tr_use_document', '=', False), ('state','!=','draft'), ('move_type','not in', ['out_invoice', 'in_refund']),  ('l10n_tr_document_number_sequence','=', False), ('l10n_tr_delivery_type','!=','printed')]}"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//field[@name='l10n_tr_document_number']" position="before">
                <field name="l10n_tr_document_number_sequence"
                       attrs="{'invisible':['|', '|', ('l10n_tr_use_document', '=', False), ('move_type','not in', ['out_invoice', 'in_refund']), ('l10n_tr_delivery_type','!=','printed')]}" domain="[('active', '=', True), ('company_id', '=', company_id), ('code', '=', 'account.invoice')]"
                       options="{'no_open': True, 'no_create': 1, 'no_create_edit': 1}"/>
            </xpath>
        </field>
    </record>
</odoo>
