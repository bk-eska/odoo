<odoo>
    <record id="view_account_journal_form_document" model="ir.ui.view">
        <field name="name">account.journal.form.document</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='refund_sequence']/.."
                   position="after">
                <group string="Printed Invoice Sequence"
                       attrs="{'invisible':['|', ('l10n_tr_use_document', '=', False),
                       ('type','not in', ['sale', 'purchase'])]}">
                    <field name="l10n_tr_document_number_sequence"
                           domain="[('code', '=', 'account.invoice'),
                           ('company_id', '=', company_id)]"
                           attrs="{'required':[('l10n_tr_use_document', '=', True),
                           ('l10n_tr_document_auto_number','=',True)]}"
                           context="{'default_code': 'account.invoice',
                           'default_padding': 6,
                           'default_implementation': 'no_gap',
                           'default_prefix': 'SERI'}"/>
                    <field name="l10n_tr_document_auto_number"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>




