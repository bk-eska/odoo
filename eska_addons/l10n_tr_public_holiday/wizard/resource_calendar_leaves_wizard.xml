<odoo>
    <record id="holiday_wizard_view_form" model="ir.ui.view">
        <field name="name">holiday.wizard.form</field>
        <field name="model">resource.calendar.leaves.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="year"/>
                </group>
                <footer>
                    <button string="Add Holidays" type="object" class="oe_highlight" name="action_add_holidays_wizard"/>
                    <button special="cancel" class="btn-secondary" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_holiday_wizard" model="ir.actions.act_window">
        <field name="name">Add Annual Holidays</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">resource.calendar.leaves.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="holiday_wizard_view_form"/>
        <field name="binding_model_id" ref="resource.model_resource_calendar"/>
        <field name="target">new</field>
    </record>
</odoo>
