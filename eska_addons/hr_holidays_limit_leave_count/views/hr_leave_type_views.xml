<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record id="hr_leave_types_form_view_duration_limit" model="ir.ui.view">
         <field name="name">hr.leave.type.form.view.duration.limit</field>
         <field name="model">hr.leave.type</field>
         <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
         <field name="arch" type="xml">
             <xpath expr="//field[@name='employee_requests']" position="after">
                 <label for="max_leave_count"/>
                 <div class="o_row" name="wage">
                     <field name="max_leave_count" nolabel="1"/>
                     <field name="leave_count_type"/>
                 </div>
             </xpath>
         </field>
     </record>
</odoo>
