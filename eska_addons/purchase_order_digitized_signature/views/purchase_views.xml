<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="purchase_order_form_signature" model="ir.ui.view">
        <field name="name">purchase.order.form.signature</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <widget name="signature"
                        string="Sign"
                        attrs="{'invisible':['|',('signature','!=',False), ('state','=','done')]}"
                        full_name="partner_id"
                />
                <button name="purchase_order_unsign"
                        string="Unsign"
                        type="object"
                        attrs="{'invisible':['|',('signature','=',False), ('state','=','done')]}"
                />
            </xpath>
            <xpath expr="//div[@name='reminder']" position="after">
                <field name="signature"
                       widget="signature"
                />
            </xpath>
        </field>
    </record>
</odoo>
