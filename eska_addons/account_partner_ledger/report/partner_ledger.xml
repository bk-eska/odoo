<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_print_report_partner_ledger_qweb" model="ir.actions.report">
        <field name="name">Partner Ledger</field>
        <field name="model">partner.ledger.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_partner_ledger.partner_ledger</field>
        <field name="report_file">account_partner_ledger.partner_ledger</field>
        <field name="paperformat_id" ref="account_financial_report.report_qweb_paperformat" />
    </record>

    <record id="action_print_report_partner_ledger_html" model="ir.actions.report">
        <field name="name">Partner Ledger</field>
        <field name="model">partner.ledger.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">account_partner_ledger.partner_ledger</field>
        <field name="report_file">account_partner_ledger.partner_ledger</field>
    </record>

    <record id="action_report_partner_ledger_xlsx" model="ir.actions.report">
        <field name="name">Partner Ledger XLSX</field>
        <field name="model">partner.ledger.report.wizard</field>
        <field name="type">ir.actions.report</field>
        <field name="report_name">account_partner_ledger.report_partner_ledger_xlsx</field>
        <field name="report_type">xlsx</field>
        <field name="report_file">report_partner_ledger</field>
    </record>

    <record id="action_print_report_partner_ledger_qweb" model="ir.actions.report">
        <field name="paperformat_id" ref="account_financial_report.report_qweb_paperformat" />
    </record>

    <record id="action_report_partner_ledger" model="ir.actions.client">
        <field name="name">Partner Ledger</field>
        <field name="tag">account_financial_report_backend</field>
        <field
            name="context"
            eval="{'model': 'report.account_partner_ledger.partner_ledger'}"
        />
    </record>

</odoo>
