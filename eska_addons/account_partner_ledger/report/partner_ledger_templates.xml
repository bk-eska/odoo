<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="partner_ledger">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="account_financial_report.internal_layout">
                    <t t-call="account_partner_ledger.report_partner_ledger_base" />
                </t>
            </t>
        </t>
    </template>
    <template id="report_partner_ledger_base">
        <t t-set="foreign_currency" t-value="foreign_currency" />
        <t t-set="title">Partner Ledger - <t t-out="company_name" /></t>
        <div class="page">
            <div class="row">
                <h4
                    class="mt0"
                    t-esc="title or 'Odoo Report'"
                    style="text-align: center;"
                />
            </div>
            <!-- Display filters -->
            <t t-call="account_partner_ledger.report_partner_ledger_filters" />
            <t t-foreach="partner_ledger" t-as="partner">
                <t t-foreach="partner['currencies']" t-as="currency">
                    <div class="page_break">
                        <!-- Display account header -->
                        <div class="act_as_table list_table" style="margin-top: 10px;" />
                        <div class="act_as_caption account_title" style="width: 100%">
                            <span
                                t-esc="partner['name']"
                            />
                            <t t-if="foreign_currency">
                                -
                            <span
                                t-esc="currency['name']"
                            />
                            </t>
                        </div>
                        <t t-call="account_partner_ledger.report_partner_ledger_lines"/>
                        <t t-call="account_partner_ledger.report_partner_ledger_ending_cumul"/>
                    </div>
                </t>
            </t>
        </div>
    </template>
    <template id="account_partner_ledger.report_partner_ledger_filters">
        <div class="act_as_table data_table" style="width: 100%;">
            <div class="act_as_row labels">
                <div class="act_as_cell">Date range filter</div>
                <div class="act_as_cell">Target moves filter</div>
            </div>
            <div class="act_as_row">
                <div class="act_as_cell">
                    From: <span t-esc="date_from" /> To: <span t-esc="date_to" />
                </div>
                <div class="act_as_cell">
                    <t t-if="only_posted_moves">All posted entries</t>
                    <t t-if="not only_posted_moves">All entries</t>
                </div>
            </div>
        </div>
    </template>
    <template id="account_partner_ledger.report_partner_ledger_lines">
        <div class="act_as_table data_table" style="width: 100%;">
            <!-- Display table headers for lines -->
            <div class="act_as_thead">
                <div class="act_as_row labels">
                    <!--## date-->
                    <div class="act_as_cell first_column" style="width: 3.51%;">
                        Date</div>
                    <!--## maturity-->
                    <div class="act_as_cell" style="width: 3.51%">Maturity</div>
                    <!--## move-->
                    <div class="act_as_cell" style="width: 8.03%">Entry</div>
                    <!--## journal-->
                    <div class="act_as_cell" style="width: 4.13%;">Journal</div>
                    <!--## account code-->
                    <div class="act_as_cell" style="width: 4.75%;">Account</div>
                    <!--## ref - label-->
                    <div class="act_as_cell" style="width: 12.9%;">Ref -
                        Label</div>
                    <!--## debit-->
                    <div class="act_as_cell amount" style="width: 8.02%;">Debit</div>
                    <!--## credit-->
                    <div class="act_as_cell amount" style="width: 8.02%;">Credit</div>
                    <!--## balance cumulated-->
                    <div
                        class="act_as_cell amount"
                        style="width: 8.02%;"
                    >Cumul. Bal.</div>
                    <t t-if="foreign_currency">
                        <!--## currency_rate-->
                        <div
                            class="act_as_cell amount"
                            style="width: 5.19%;"
                        >Cur. Rate</div>
                        <!--## amount_currency-->
                        <div
                            class="act_as_cell amount"
                            style="width: 5.19%;"
                        >Amount cur.</div>
                        <!--## balance_currency-->
                        <div
                            class="act_as_cell amount"
                            style="width: 5.19%;"
                        >Balance Cur.</div>
                    </t>
                </div>
            </div>
            <!-- Display first line with initial balance -->
            <div class="act_as_row lines">
                <!--## date-->
                <div class="act_as_cell" />
                <!--## maturity-->
                <div class="act_as_cell" />
                <!--## move-->
                <div class="act_as_cell" />
                <!--## journal-->
                <div class="act_as_cell" />
                <!--## account code-->
                <div class="act_as_cell" />
                <!--## ref - label-->
                <div class="act_as_cell amount">Initial balance</div>
                <!--## debit-->
                <div class="act_as_cell amount">
                    <t
                        t-set="domain"
                        t-value="[('currency_id', '=', currency['id']),
                                 ('partner_id', '=', partner['id']),
                                 ('date', '&lt;', date_from),
                                 ('debit', '&lt;&gt;', 0)]"
                    />
                    <span>
                        <a
                            t-att-data-domain="domain"
                            t-att-data-res-model="'account.move.line'"
                            class="o_account_financial_reports_web_action_monetary_multi"
                            style="color: black;"
                        >
                            <t
                                t-out="currency['init_bal']['debit']"
                                t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                            />
                        </a>
                    </span>
                </div>
                <!--## credit-->
                <div class="act_as_cell amount">
                    <t
                        t-set="domain"
                        t-value="[('currency_id', '=', currency['id']),
                                 ('partner_id', '=', partner['id']),
                                 ('date', '&lt;', date_from),
                                 ('credit', '&lt;&gt;', 0)]"
                    />
                    <span>
                        <a
                            t-att-data-domain="domain"
                            t-att-data-res-model="'account.move.line'"
                            class="o_account_financial_reports_web_action_monetary_multi"
                            style="color: black;"
                        >
                            <t
                                t-out="currency['init_bal']['credit']"
                                t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                            />
                        </a>
                    </span>
                </div>
                <!--## balance cumulated-->
                <div class="act_as_cell amount">
                    <t
                        t-set="domain"
                        t-value="[('currency_id', '=', currency['id']),
                                 ('partner_id', '=', partner['id']),
                                 ('date', '&lt;', date_from)]"
                    />
                    <span>
                        <a
                            t-att-data-domain="domain"
                            t-att-data-res-model="'account.move.line'"
                            class="o_account_financial_reports_web_action_monetary_multi"
                            style="color: black;"
                        >
                            <t
                                t-out="currency['init_bal']['balance']"
                                t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                            />
                        </a>
                    </span>
                </div>
                <t t-if="foreign_currency">
                    <t
                        t-if="currency['id'] != res_company.currency_id.id"
                    >
                        <div class="act_as_cell" style="width: 5.19%;" />
                        <div class="act_as_cell" style="width: 5.19%;" />
                        <div class="act_as_cell amount" style="width: 5.19%;">
                            <t
                                t-set="domain"
                                t-value="[('currency_id', '=', currency['id']),
                                         ('partner_id', '=', partner['id']),
                                         ('date', '&lt;', o.date_from)]"
                            />
                            <span>
                                <a
                                    t-att-data-domain="domain"
                                    t-att-data-res-model="'account.move.line'"
                                    class="o_account_financial_reports_web_action_monetary_multi"
                                    style="color: black;"
                                >
                                    <t
                                        t-out="currency['init_bal']['bal_curr']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency['currency_id']}"
                                    />
                                </a>
                            </span>
                        </div>
                    </t>
                    <t
                        t-if="currency['id'] == res_company.currency_id.id"
                    >
                        <div class="act_as_cell" style="width: 5.19%;" />
                        <div class="act_as_cell" style="width: 5.19%;" />
                        <div class="act_as_cell" style="width: 5.19%;" />
                    </t>
                </t>
            </div>
            <!-- Display each lines -->
            <t t-foreach="currency['move_lines']" t-as="line">
                <!-- # lines or centralized lines -->
                <div class="act_as_row lines">
                    <!--## date-->
                    <div class="act_as_cell left">
                        <span>
                            <t t-if="line['id']">
                                <a
                                    t-att-data-active-id="line['id']"
                                    t-att-data-res-model="'account.move.line'"
                                    class="o_account_financial_reports_web_action"
                                    style="color: black;"
                                >
                                    <!--## We don't use t-field because it throws an error on click -->
                                    <t
                                        t-esc="line['date']"
                                        t-options="{'widget': 'date'}"
                                    />
                                </a>
                            </t>
                            <t t-if="not line['id']">
                                <a
                                    class="o_account_financial_reports_web_action"
                                    style="color: black;"
                                >
                                    <!--## We don't use t-field because it throws an error on click -->
                                    <t
                                        t-esc="line['date']"
                                        t-options="{'widget': 'date'}"
                                    />
                                </a>
                            </t>
                        </span>
                    </div>
                    <!--## maturity-->
                    <div class="act_as_cell left">
                        <span>
                            <t t-if="line['date'] != line['date_maturity']">
                                <a
                                    class="o_account_financial_reports_web_action"
                                    style="color: black;"
                                >
                                    <!--## We don't use t-field because it throws an error on click -->
                                    <t
                                        t-esc="line['date_maturity']"
                                        t-options="{'widget': 'date'}"
                                    />
                                </a>
                            </t>
                        </span>
                    </div>
                    <!--## move-->
                    <div class="act_as_cell left">
                        <t t-if="line['entry_id']">
                            <span>
                                <a
                                    t-att-data-active-id="line['entry_id']"
                                    t-att-data-res-model="'account.move.line'"
                                    class="o_account_financial_reports_web_action"
                                    style="color: black;"
                                >
                                    <t t-out="line['entry']" />
                                </a>
                            </span>
                        </t>
                    </div>
                    <!--## journal-->
                    <div class="act_as_cell left">
                        <span>
                            <a
                                t-att-data-active-id="line['journal_id']"
                                t-att-data-res-model="'account.move.line'"
                                class="o_account_financial_reports_web_action"
                                style="color: black;"
                            >
                                <t
                                    t-out="o._get_atr_from_dict(line['journal_id'], journals_data, 'code')"
                                />
                            </a>
                        </span>
                    </div>
                    <!--## account code-->
                    <div class="act_as_cell left">
                        <span>
                            <a
                                t-att-data-active-id="line['account_id']"
                                t-att-data-res-model="'account.move.line'"
                                class="o_account_financial_reports_web_action"
                                style="color: black;"
                            >
                                <t
                                    t-out="o._get_atr_from_dict(line['account_id'], accounts_data, 'code')"
                                />
                            </a>
                        </span>
                    </div>
                    <!--## ref - label-->
                    <div class="act_as_cell left">
                        <t t-if="line['id']">
                            <span>
                                <a
                                    t-att-data-active-id="line['id']"
                                    t-att-data-res-model="'account.move.line'"
                                    class="o_account_financial_reports_web_action"
                                    style="color: black;"
                                >
                                    <t t-out="line['ref']" />
                                </a>
                            </span>
                        </t>
                        <t t-if="not line['id']">
                            <span>
                                <a
                                    class="o_account_financial_reports_web_action"
                                    style="color: black;"
                                >
                                    <t t-out="line['ref']" />
                                </a>
                            </span>
                        </t>
                    </div>
                    <!--## debit-->
                    <div class="act_as_cell amount">
                        <t t-if="line['id']">
                            <span>
                                <a
                                    t-att-data-active-id="line['id']"
                                    t-att-data-res-model="'account.move.line'"
                                    class="o_account_financial_reports_web_action_monetary"
                                    style="color: black;"
                                >
                                    <t
                                        t-out="line['debit']"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                    />
                                </a>
                            </span>
                        </t>
                        <t t-if="not line['id']">
                            <span>
                                <a
                                    class="o_account_financial_reports_web_action_monetary"
                                    style="color: black;"
                                >
                                    <t
                                        t-out="line['debit']"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                    />
                                </a>
                            </span>
                        </t>
                    </div>
                    <!--## credit-->
                    <div class="act_as_cell amount">
                        <t t-if="line['id']">
                            <span>
                                <a
                                    t-att-data-active-id="line['id']"
                                    t-att-data-res-model="'account.move.line'"
                                    class="o_account_financial_reports_web_action_monetary"
                                    style="color: black;"
                                >
                                    <t
                                        t-out="line['credit']"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                    />
                                </a>
                            </span>
                        </t>
                        <t t-if="not line['id']">
                            <span>
                                <a
                                    class="o_account_financial_reports_web_action_monetary"
                                    style="color: black;"
                                >
                                    <t
                                        t-out="line['credit']"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                    />
                                </a>
                            </span>
                        </t>
                    </div>
                    <!--## balance cumulated-->
                    <div class="act_as_cell amount">
                        <t t-if="line['id']">
                            <span>
                                <a
                                    t-att-data-active-id="line['id']"
                                    t-att-data-res-model="'account.move.line'"
                                    class="o_account_financial_reports_web_action_monetary"
                                    style="color: black;"
                                >
                                    <t
                                        t-out="line['balance']"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                    />
                                </a>
                            </span>
                        </t>
                        <t t-if="not line['id']">
                            <span>
                                <a
                                    class="o_account_financial_reports_web_action_monetary"
                                    style="color: black;"
                                >
                                    <t
                                        t-out="line['balance']"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                    />
                                </a>
                            </span>
                        </t>
                    </div>
                    <t t-if="foreign_currency">
                        <t t-if="line['currency_id'][0] != res_company.currency_id.id">
                           <!--## currency_rate -->
                            <div class="act_as_cell amount" style="width: 5.19%;">
                                <span>
                                    <a
                                        t-att-data-active-id="line['id']"
                                        t-att-data-res-model="'account.move.line'"
                                        class="o_account_financial_reports_web_action"
                                        style="color: black;"
                                    >
                                    <t
                                        t-out="line['currency_rate']"
                                        t-options="{'widget': 'float', 'precision': 4}"
                                    />
                                    </a>
                                </span>
                            </div>
                            <!--## amount_currency-->
                            <div class="act_as_cell amount" style="width: 5.19%;">
                                <span>
                                    <a
                                        t-att-data-active-id="line['id']"
                                        t-att-data-res-model="'account.move.line'"
                                        class="o_account_financial_reports_web_action"
                                        style="color: black;"
                                    >
                                    <t
                                        t-out="line['amount_currency']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency['currency_id']}"
                                    />
                                    </a>
                                </span>
                            </div>
                             <!--## balance_currency-->
                            <div class="act_as_cell amount" style="width: 5.19%;">
                                <span>
                                    <a
                                        t-att-data-active-id="line['id']"
                                        t-att-data-res-model="'account.move.line'"
                                        class="o_account_financial_reports_web_action"
                                        style="color: black;"
                                    >
                                        <t
                                                t-out="line['bal_curr']"
                                                t-options="{'widget': 'monetary', 'display_currency': currency['currency_id']}"
                                        />
                                    </a>
                                </span>
                            </div>
                        </t>
                        <t t-else="">
                            <!--## currency_rate-->
                            <div class="act_as_cell amount" style="width: 5.19%;" />
                            <!--## currency_name-->
                            <div class="act_as_cell amount" style="width: 5.19%;" />
                            <!--## amount_currency-->
                            <div class="act_as_cell amount" style="width: 5.19%;" />
                        </t>
                    </t>
                </div>
            </t>
        </div>
    </template>
    <template id="account_partner_ledger.report_partner_ledger_ending_cumul">
        <!-- Display ending balance line for account or partner -->
        <div class="act_as_table list_table" style="width: 100%;">
            <div class="act_as_row labels" style="font-weight: bold;">
                <!--## date-->
                <div class="act_as_cell first_column" style="width: 23.93%;" />
                <div
                    class="act_as_cell right"
                    style="width: 12.9%;"
                >Ending balance</div>
                <!--## debit-->
                <div class="act_as_cell amount" style="width: 8.02%;">
                    <span
                        t-esc="currency['fin_bal']['debit']"
                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                    />
                </div>
                <!--## credit-->
                <div class="act_as_cell amount" style="width: 8.02%;">
                    <span
                        t-esc="currency['fin_bal']['credit']"
                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                    />
                </div>
                <!--## balance cumulated-->
                <div class="act_as_cell amount" style="width: 8.02%;">
                    <span
                        t-esc="currency['fin_bal']['balance']"
                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                    />
                </div>
                <!--## currency_name + amount_currency-->
                <t t-if="foreign_currency">
                    <t
                        t-if="currency['id'] != res_company.currency_id.id"
                    >
                        <div class="act_as_cell" style="width: 5.19%;" />
                        <div class="act_as_cell" style="width: 5.19%;" />
                        <div class="act_as_cell amount" style="width: 5.19%;">
                            <t
                                t-set="domain"
                                t-value="[('currency_id', '=', currency['id']),
                                         ('partner_id', '=', partner['id']),
                                         ('date', '&lt;', date_from)]"
                            />
                            <span>
                                <a
                                    t-att-data-domain="domain"
                                    t-att-data-res-model="'account.move.line'"
                                    class="o_account_financial_reports_web_action_monetary_multi"
                                    style="color: black;"
                                >
                                    <t
                                        t-out="currency['fin_bal']['bal_curr']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency['currency_id']}"
                                    />
                                </a>
                            </span>
                        </div>
                    </t>
                    <t
                        t-if="currency['id'] == res_company.currency_id.id"
                    >
                        <div class="act_as_cell" style="width: 5.19%;" />
                        <div class="act_as_cell" style="width: 5.19%;" />
                        <div class="act_as_cell" style="width: 5.19%;" />
                    </t>
                </t>
            </div>
        </div>
    </template>

</odoo>
