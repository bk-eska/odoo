<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_limit" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.send.limit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="85"/>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="inside">
                <div class="col-lg-6 col-12 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Email Limit</span>
                        <div class="text-muted" id="external_email_server_default">
                            Set number of mails to send at once
                        </div>
                        <div class="content-group">
                            <div class="mt16 row">
                                <label for="mail_limit" string="Limit" class="col-3 col-lg-3 o_light_label"/>
                                <field name="mail_limit" class="oe_inline" required="1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
