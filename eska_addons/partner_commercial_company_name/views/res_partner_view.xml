<odoo>
    <record id="view_partner_form_commercial_name" model="ir.ui.view">
        <field name="name">res.partner.property.form.commercial.name</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']/parent::div" position="before">
                <field name="commercial_name"
                       attrs="{'invisible': [('is_company','=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
