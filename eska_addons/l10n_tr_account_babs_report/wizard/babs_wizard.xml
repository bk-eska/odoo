<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="babs_report_wizard_form" model="ir.ui.view">
        <field name="name">babs.report.wizard.form</field>
        <field name="model">babs.report.wizard</field>
        <field name="arch" type="xml">
            <form name="BA/BS Report">
                <group name="Filters">
                    <group>
                        <field name="date_range_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="declaration_type" widget="radio"/>
                        <field name="target_move" widget="radio"/>
                        <field name="threshold"/>
                    </group>
                </group>
                <footer>
<!--                    <button name="button_export_pdf"-->
<!--                            string="Export PDF"-->
<!--                            type="object"/>-->
<!--                    or-->
                    <button name="button_export_xlsx"
                            string="Export XLSX"
                            type="object"/>
<!--                    or-->
<!--                    <button name="button_export_xml_txt"-->
<!--                            string="Export XML TXT"-->
<!--                            type="object"/>-->
<!--                    or-->
                    <button string="Cancel"
                            class="oe_link"
                            special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="babs_report_wizard_action" model="ir.actions.act_window">
        <field name="name">BA/BS Report</field>
        <field name="res_model">babs.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="babs_report_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
