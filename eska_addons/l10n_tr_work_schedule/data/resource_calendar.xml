<odoo>
	<data>
        <record id="tr_work_schedule" model="resource.calendar">
            <field name="name">Standart 45 Saat/Hafta</field>
            <field name="tz">Europe/Istanbul</field>
            <field name="hours_per_day">8</field>
        </record>
	</data>
    <data noupdate="1">
        <record model="resource.calendar.attendance" id="tr_work_schedule_monday_morning">
            <field name="name">Pazartesi sabah</field>
            <field name="dayofweek">0</field>
            <field name="hour_from">9</field>
            <field name="hour_to">13</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
        <record model="resource.calendar.attendance" id="tr_work_schedule_monday_evening">
            <field name="name">Pazartesi öğleden sonra</field>
            <field name="dayofweek">0</field>
            <field name="hour_from">14</field>
            <field name="hour_to">18</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
        <record model="resource.calendar.attendance" id="tr_work_schedule_tuesday_morning">
            <field name="name">Salı sabah</field>
            <field name="dayofweek">1</field>
            <field name="hour_from">9</field>
            <field name="hour_to">13</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
        <record model="resource.calendar.attendance" id="tr_work_schedule_tuesday_evening">
            <field name="name">Salı öğleden sonra</field>
            <field name="dayofweek">1</field>
            <field name="hour_from">14</field>
            <field name="hour_to">18</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
		<record model="resource.calendar.attendance" id="tr_work_schedule_wednesday_morning">
            <field name="name">Çarşamba sabah</field>
            <field name="dayofweek">2</field>
            <field name="hour_from">9</field>
            <field name="hour_to">13</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
        <record model="resource.calendar.attendance" id="tr_work_schedule_wednesday_evening">
            <field name="name">Çarşamba öğleden sonra</field>
            <field name="dayofweek">2</field>
            <field name="hour_from">14</field>
            <field name="hour_to">18</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
		<record model="resource.calendar.attendance" id="tr_work_schedule_thursday_morning">
            <field name="name">Perşembe sabah</field>
            <field name="dayofweek">3</field>
            <field name="hour_from">9</field>
            <field name="hour_to">13</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
        <record model="resource.calendar.attendance" id="tr_work_schedule_thursday_evening">
            <field name="name">Perşembe öğleden sonra</field>
            <field name="dayofweek">3</field>
            <field name="hour_from">14</field>
            <field name="hour_to">18</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
		<record model="resource.calendar.attendance" id="tr_work_schedule_friday_morning">
            <field name="name">Cuma sabah</field>
            <field name="dayofweek">4</field>
            <field name="hour_from">9</field>
            <field name="hour_to">13</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
        <record model="resource.calendar.attendance" id="tr_work_schedule_friday_evening">
            <field name="name">Cuma öğleden sonra</field>
            <field name="dayofweek">4</field>
            <field name="hour_from">14</field>
            <field name="hour_to">18</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
		<record model="resource.calendar.attendance" id="tr_work_schedule_saturday_morning">
            <field name="name">Cumartesi sabah</field>
            <field name="dayofweek">5</field>
            <field name="hour_from">9</field>
            <field name="hour_to">14</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="tr_work_schedule"/>
        </record>
        <record id="tr_work_schedule" model="resource.calendar">
            <field name="attendance_ids" eval="[(6, 0, [
            ref('tr_work_schedule_monday_morning'),
            ref('tr_work_schedule_monday_evening'),
            ref('tr_work_schedule_tuesday_morning'),
            ref('tr_work_schedule_tuesday_evening'),
            ref('tr_work_schedule_wednesday_morning'),
            ref('tr_work_schedule_wednesday_evening'),
            ref('tr_work_schedule_thursday_morning'),
            ref('tr_work_schedule_thursday_evening'),
            ref('tr_work_schedule_friday_morning'),
            ref('tr_work_schedule_friday_evening'),
            ref('tr_work_schedule_saturday_morning'),
            ])]"/>
        </record>
	</data>
</odoo>
