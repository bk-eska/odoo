<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_refuse_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.leave.refuse.wizard.form</field>
        <field name="model">hr.leave.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Leave refuse reason">
                <separator string="Reason to refuse Leave Request"/>
                <field name="hr_leave_ids" invisible="1"/>
                <field name="reason" required="1"/>
                <footer>
                    <button string='Refuse' name="leave_refuse_reason" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
           </form>
        </field>
    </record>

    <record id="hr_leave_refuse_wizard_action" model="ir.actions.act_window">
        <field name="name">Refuse Leave Request</field>
        <field name="res_model">hr.leave.refuse.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_leave_refuse_wizard_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
