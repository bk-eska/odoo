<odoo>
    <data noupdate="1">
        <record forcecreate="True" id="ir_cron_edespatch_get_despatch_action"
                model="ir.cron">
            <field name="name">E-Despatch Get Despatches</field>
            <field name="model_id" ref="model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.run_get_edespatch_despatches()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
        </record>
        <record forcecreate="True"
                id="ir_cron_edespatch_get_responses_action" model="ir.cron">
            <field name="name">E-Despatch Get Receipts</field>
            <field name="model_id" ref="model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.run_get_edespatch_receipts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
        </record>
        <record forcecreate="True"
                id="ir_cron_edespatch_update_despatches_action"
                model="ir.cron">
            <field name="name">E-Despatch Update Status Of Despatches</field>
            <field name="model_id" ref="model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.run_update_edespatches()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
        </record>
        <record forcecreate="True"
                id="ir_cron_edespatch_get_edespatch_registered_users_action"
                model="ir.cron">
            <field name="name">E-Despatch Get Registered Users</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.run_get_edespatch_users()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
