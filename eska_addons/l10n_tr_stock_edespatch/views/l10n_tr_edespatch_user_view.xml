<odoo>
    <record model="ir.ui.view" id="view_edespatch_user_tree">
        <field name="name">l10n_tr.edespatch.user.tree</field>
        <field name="model">l10n_tr.edespatch.user</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree string="Registered Users" create="0" edit="0">
                <field name="identifier"/>
                <field name="alias"/>
                <field name="title"/>
                <field name="type"/>
                <field name="first_created"/>
                <field name="alias_created"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_edespatch_user_search">
        <field name="name">l10n_tr.edespatch.user.search</field>
        <field name="model">l10n_tr.edespatch.user</field>
        <field name="arch" type="xml">
            <search string="Registered Users">
                <field name="identifier"/>
                <field name="alias"/>
                <field name="title"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_edespatch_user">
        <field name="name">E-Despatch Registered Users</field>
        <field name="res_model">l10n_tr.edespatch.user</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_edespatch_user_search"/>
        <field name="view_id" ref="view_edespatch_user_tree"/>
        <field name="context">{'search_default_state':'active'}</field>
    </record>

    <menuitem id="menu_l10n_tr_edespatch_user"
              action="action_edespatch_user"
              parent="stock.menu_stock_config_settings"
              sequence="3"/>

</odoo>
