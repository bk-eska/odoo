<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_edespatch" model="ir.ui.view">
        <field name="name">stock.picking.form.edespatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='note']" position="after">
                <page string="E-Despatch" attrs="{'invisible':[('l10n_tr_document_type','!=','edespatch')]}">
                    <group>
                        <group>
                            <field name="l10n_tr_edespatch_sequence"
                                   attrs="{'invisible':[('picking_type_code','not in',['outgoing', 'internal'])],
                                   'required':['&amp;',('l10n_tr_document_type','=','edespatch'),('picking_type_code','in',['outgoing', 'internal'])]}"
                                   domain="[('active', '=', True),('company_id', '=', company_id),('code', '=', 'stock.edespatch')]"
                                   options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                            <field name="l10n_tr_edespatch_uuid" attrs="{'invisible':[('l10n_tr_edespatch_uuid','=', False)]}"/>
                            <field name="l10n_tr_edespatch_envelope_uuid" attrs="{'invisible':[('l10n_tr_edespatch_envelope_uuid','=', False)]}"/>
                            <field name="l10n_tr_edespatch_response_uuid" attrs="{'invisible':[('l10n_tr_edespatch_response_uuid','=', False)]}"/>
                            <field name="l10n_tr_edespatch_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_tr_edespatch_candidate_sender_ids" invisible="1"/>
                            <field name="l10n_tr_edespatch_candidate_postbox_ids" invisible="1"/>
                            <field name="l10n_tr_edespatch_sender_id"
                                   attrs="{'required':[('l10n_tr_document_type','=','edespatch'),
                                   ('picking_type_code','in',['outgoing', 'internal'])]}"
                                   domain="[('id', 'in', l10n_tr_edespatch_candidate_sender_ids)]"
                                   options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                            <field name="l10n_tr_edespatch_postbox_id"
                                   attrs="{'required':[('l10n_tr_document_type','=','edespatch')]}"
                                   domain="[('id', 'in', l10n_tr_edespatch_candidate_postbox_ids)]"
                                   options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                            <field name="l10n_tr_edespatch_zip"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//button[@name='do_print_picking']" position="before">
                <button name="%(act_l10n_tr_edespatch_match)d"
                        string="Match"
                        attrs="{'invisible': ['|', '|',
                        ('state', 'in', ('done', 'cancel')),
                        ('l10n_tr_document_type', '!=', 'edespatch'),
                        ('picking_type_code', '!=', 'incoming')]}"
                        type="action"
                        groups="base.group_user"
                        class="oe_highlight"/>
                <button name="action_edespatch_resend"
                        type="object"
                        string="Resend"
                        attrs="{'invisible':['|',
                        ('l10n_tr_edespatch_state','!=','failed'),
                        ('picking_type_code','not in',['outgoing', 'internal'])]}"
                        groups="base.group_user"
                        class="oe_highlight"/>
                <button name="action_edespatch_get_status"
                        type="object"
                        string="Get Status"
                        attrs="{'invisible':[('l10n_tr_edespatch_state', 'not in', ['sent', 'failed'])]}"
                        groups="base.group_user"
                        class="oe_highlight"/>
            </xpath>
            <!-- invisible on outgoing e-despatches -->
            <xpath expr="//field[@name='l10n_tr_document_number']" position="attributes">
                <attribute name="attrs">{'invisible':['|', '|',
                    ('l10n_tr_use_document', '=', False),
                    ('l10n_tr_document_type', '=', 'invoice'),
                    '&amp;','&amp;',
                    ('l10n_tr_document_type','=','edespatch'),
                    ('picking_type_code','in',['outgoing','internal']),
                    ('state','!=','done')],
                    'readonly':['|', ('state', '=', 'cancel'),
                     '&amp;', ('state', '=', 'done'), ('picking_type_code', '!=', 'incoming')]}
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_edespatch" model="ir.ui.view">
        <field name="name">stock.picking.tree.edespatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="l10n_tr_edespatch_state"/>
            </xpath>
        </field>
    </record>


    <record id="view_picking_internal_search_edespatch" model="ir.ui.view">
        <field name="name">stock.picking.internal.search.edespatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='status']" position="after">
                <filter string="E-Despatch Status" name="l10n_tr_edespatch_state"
                        context="{'group_by':'l10n_tr_edespatch_state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
