<odoo>

    <record id="act_l10n_tr_edespatch_match" model="ir.actions.act_window">
        <field name="name">Match E-Despatch</field>
        <field name="res_model">l10n_tr.edespatch.match</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>

    <record id="view_l10n_tr_edespatch_match_form" model="ir.ui.view">
        <field name="name">E-Despatch Match</field>
        <field name="model">l10n_tr.edespatch.match</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="partner_id"/>
                    <field name="src_picking_id" invisible="1"/>
                    <field name="picking_id"
                           domain="[('partner_id', '=', partner_id),
                           ('picking_type_code', '=', 'incoming'),
                           ('id', '!=', src_picking_id),
                           ('state', 'not in', ['done', 'cancel'])]"/>
                </group>
                <footer>
                    <button name="edespatch_match"
                            string="Match"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel" />
                </footer>
            </form>
        </field>
    </record>


</odoo>