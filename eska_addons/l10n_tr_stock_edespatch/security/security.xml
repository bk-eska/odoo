<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stock_edespatch_postbox_rule" model="ir.rule">
            <field name="name">E-Despatch Postboxes Rule</field>
            <field name="model_id" ref="model_l10n_tr_edespatch_postbox"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <record id="l10n_tr_edespatch_sender_rule" model="ir.rule">
            <field name="name">E-Despatch Senders Rule</field>
            <field name="model_id" ref="model_l10n_tr_edespatch_sender"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
