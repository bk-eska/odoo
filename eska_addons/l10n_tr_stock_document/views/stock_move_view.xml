<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_tree_document" model="ir.ui.view">
        <field name="name">stock.move.tree.document</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="l10n_tr_document_number" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_search_document" model="ir.ui.view">
        <field name="name">stock.move.search.document</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="filter_domain">[
                    '|', '|', '|',
                    ('origin', 'ilike', self),
                    ('name', 'ilike', self),
                    ('picking_id', 'ilike', self),
                    ('l10n_tr_document_number', 'ilike', self)]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible':[('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
