<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_internal_search_document" model="ir.ui.view">
        <field name="name">stock.picking.internal.document.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="filter_domain">[
                    '|', '|',
                    ('name', 'ilike', self),
                    ('origin', 'ilike', self),
                    ('l10n_tr_document_number', 'ilike', self)]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_tr_document_number"/>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_form_document" model="ir.ui.view">
        <field name="name">stock.picking.document.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_type"
                       attrs="{'invisible':[('l10n_tr_use_document', '=', False)]}"/>
                <field name="l10n_tr_document_number"
                       attrs="{'invisible':['|', ('l10n_tr_use_document', '=', False),
                     ('l10n_tr_document_type', '=', 'invoice')],
                     'readonly':['|', ('state', '=', 'cancel'),
                     '&amp;', ('state', '=', 'done'), ('picking_type_code', '!=', 'incoming')]}"/>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="l10n_tr_date_despatch"
                       attrs="{'invisible':[('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_tree_document" model="ir.ui.view">
        <field name="name">stock.picking.document.tree</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_tr_document_number" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field name="l10n_tr_date_despatch" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
