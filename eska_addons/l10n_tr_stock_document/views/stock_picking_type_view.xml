<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_document" model="ir.ui.view">
        <field name="name">stock.picking.type.document.form</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="l10n_tr_use_document" invisible="1"/>
                <field name="l10n_tr_document_number_required"
                       attrs="{'invisible':[('l10n_tr_use_document', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
