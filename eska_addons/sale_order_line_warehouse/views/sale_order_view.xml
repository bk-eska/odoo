<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_line_warehouse" model="ir.ui.view">
        <field name="name">sale.order.form.line.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//field[@name='tax_id']"
                position="after"
            >
                <field name="warehouse_id" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='price_unit']"
                position="after"
            >
                <field name="warehouse_id" optional="show" />
            </xpath>
        </field>
    </record>
    <record id="sale_order_line_tree_view_warehouse" model="ir.ui.view">
        <field name="name">sale.order.line.tree.warehouse</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='price_subtotal']" position="before">
                <field name="warehouse_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>