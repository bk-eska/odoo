<odoo>
    <record id="view_stock_ledger_report_wizard" model="ir.ui.view">
        <field name="name">stock.ledger.report.wizard.form</field>
        <field name="model">stock.ledger.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Ledger Report Wizard">
                <group>
                    <field name="location_id" domain="[('usage', '=', 'internal')]"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <group>
                    <field name="show_price"/>
                    <field name="product_ids">
                        <tree>
                            <field name="default_code"/>
                            <field name="name" colspan="4"/>
                            <field name="barcode"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_export_stock_report"
                            string="Export Report"
                            class="oe_highlight fa fa-download"
                            type="object"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_ledger_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Stock Ledger Report XLSX</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.ledger.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock_ledger_report.view_stock_ledger_report_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_action_invoice_report"
              name="Stock Ledger Report"
              parent="stock.menu_warehouse_report"
              sequence="232"
              action="stock_ledger_report.stock_ledger_report_wizard_action"
              groups="stock.group_stock_manager"/>
</odoo>
