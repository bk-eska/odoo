<odoo>
    <record id="view_holidays_advance_inherited_form" model="ir.ui.view">
        <field name="name">view.holidays.advance.inherited.form</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='leave_validation_type']" position="after">
                <field name="advance_enabled"
                       attrs="{'invisible':[('requires_allocation', '=', 'no')]}" />
                <field name="advance_allowed"
                       attrs="{'invisible':['|', ('requires_allocation', '=', 'no'), ('advance_enabled', '!=', True)],
                                'required':['|', ('requires_allocation', '!=', 'no'), ('advance_enabled', '=', True)]}" />
                <field name="advance_start_month"
                       attrs="{'invisible':['|', ('requires_allocation', '=', 'no'), ('advance_enabled', '!=', True)],
                                'required':['|', ('requires_allocation', '!=', 'no'), ('advance_enabled', '=', True)]}" />
                <field name="advance_end_month"
                       attrs="{'invisible':['|', ('requires_allocation', '=', 'no'), ('advance_enabled', '!=', True)],
                                'required':['|', ('requires_allocation', '!=', 'no'), ('advance_enabled', '=', True)]}" />
            </xpath>
        </field>
    </record>
</odoo>