<odoo>
    <record model="ir.ui.view" id="view_invoice_tree_confirm_date">
        <field name="name">account.move.tree.confirm.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="confirm_date"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_move_form_confirm_date">
        <field name="name">account.move.form.confirm.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="confirm_date"
                       attrs="{'invisible': [('confirm_date', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
