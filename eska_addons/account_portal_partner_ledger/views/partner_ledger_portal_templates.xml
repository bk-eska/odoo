<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_breadcrumbs_ledger" name="Portal layout: partner ledger menu" inherit_id="portal.portal_breadcrumbs" priority="35">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'ledger' or ledger" t-attf-class="breadcrumb-item #{'active' if not ledger else ''}">
                <t>Partner Ledger</t>
            </li>
        </xpath>
    </template>

    <template id="portal_layout_my_ledger" inherit_id="portal.portal_layout">
        <xpath expr="//div[hasclass('o_portal_my_details')]" position="inside">
            <div class='mt16'>
                <a t-attf-href="/my/ledger?{{ keep_query() }}">Partner Ledger</a>
            </div>
        </xpath>
    </template>

    <template id="portal_my_ledger" name="My Ledger">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Ledger</t>
            </t>
            <t t-if="not ledger">
                <p>There are currently no record for your account.</p>
            </t>
            <t t-if="ledger" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Date</th>
                        <th>Document</th>
                        <th>Ref</th>
                        <th class="text-center">Debit</th>
                        <th class="text-center">Credit</th>
                        <th class="text-end">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="ledger.sudo()" t-as="line">
                        <tr>
                            <td>
                                <t t-esc="line.date.strftime('%d-%m-%Y')"/>
                            </td>
                            <td>
                                <t t-esc="line.move_id.name"/>
                            </td>
                            <td>
                                <t t-esc="line.ref"/>
                            </td>
                            <td class="text-center">
                                <t t-esc="line.debit"/>
                            </td>
                            <td class="text-center">
                                <t t-esc="line.credit"/>
                            </td>
                            <td class="text-end">
                                <t t-esc="line.balance"
                                   t-options='{"widget": "monetary", "display_currency": line.company_currency_id}'/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>
</odoo>