<odoo>
    <record model="ir.ui.view"
            id="account_payment_register_form_currency_rate_type">
        <field name="name">account.payment.form.currency.fixed.rate</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id"
               ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_rate_method']"
                   position="after">
                <span class="oe_inline o_form_label mr-3 ml-5"
                      attrs="{'invisible':[('currency_rate_method','!=','rate_type')]}"
                      groups="base.group_multi_currency"> </span>
                <field name="currency_rate_type_id"
                       options="{'no_create': True, 'no_edit': True}"
                       attrs="{'invisible': [('currency_rate_method','!=','rate_type')],
                       'required':[('currency_rate_method','=', 'rate_type')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
