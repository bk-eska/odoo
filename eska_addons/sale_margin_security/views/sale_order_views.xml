<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="sale_order_hide_margin">
        <field name="name">sale.order.hide.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='margin']" position="attributes">
                <attribute name="groups">sale_margin_security.hide_sale_margin</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='margin_percent']" position="attributes">
                <attribute name="groups">sale_margin_security.hide_sale_margin</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='purchase_price']" position="attributes">
                <attribute name="groups">sale_margin_security.hide_sale_margin</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='purchase_price']" position="attributes">
                <attribute name="groups">sale_margin_security.hide_sale_margin</attribute>
            </xpath>
            <xpath expr="//group[@name='note_group']//field[@name='margin']" position="attributes">
                <attribute name="groups">sale_margin_security.hide_sale_margin</attribute>
            </xpath>
            <xpath expr="//group[@name='note_group']//field[@name='margin_percent']/.." position="attributes">
                <attribute name="groups">sale_margin_security.hide_sale_margin</attribute>
            </xpath>
        </field>
    </record>
</odoo>