<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoice_add_sale_line_view_form" model="ir.ui.view">
        <field name="name">invoice.add.sale.line.wizard.form</field>
        <field name="model">invoice.add.sale.line.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="sale_line_ids"
                           nolabel="1" colspan="2"
                           context="{'tree_view_ref': 'account_invoice_add_sale_line.view_invoice_add_sale_line_tree'}"/>
                </group>
                <footer>
                    <button string="Generate" type="object" class="oe_highlight" name="action_add_sale_line"/>
                    <button string="Generate &amp; New" type="object" class="oe_highlight" name="action_add_sale_line_and_new"/>
                    <button special="cancel" class="btn-secondary" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="invoice_add_sale_line_action" model="ir.actions.act_window">
        <field name="name">Add Sale Line</field>
        <field name="res_model">invoice.add.sale.line.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
