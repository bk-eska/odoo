<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_add_sale_line" model="ir.ui.view">
        <field name="name">account.move.form.add.sale.line</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="after">
                <button
                    name="action_add_sale_line"
                    type="object"
                    string="Add Sale Lines"
                    attrs="{'invisible': ['|', ('move_type', '!=', 'out_invoice'), ('state', 'in', ['posted', 'cancel'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>