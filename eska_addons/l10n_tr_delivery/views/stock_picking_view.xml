<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="name">delivery.stock.picking_withcarrier.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='weight']/parent::div" position="after">
                <label for="l10n_tr_weight_additional" string="Additional Weight"/>
                <div>
                    <field name="l10n_tr_weight_additional" class="oe_inline"/>
                    <field name="weight_uom_name" nolabel="1" class="oe_inline" style="margin-left:5px"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='shipping_weight']/parent::div" position="after">
                <field name="l10n_tr_number_of_packages"/>
            </xpath>
            <xpath expr="//page[@name='extra']" position="inside">
                <separator string="Transport Information"/>
                <group>
                    <group name='transporter'>
                        <field name="l10n_tr_transporter_id"
                               domain="[('l10n_tr_is_transporter','=',True)]"
                               context="{'default_l10n_tr_is_transporter': True}"
                               attrs="{'readonly': [('state', 'in',
                               ('done', 'cancel'))]}"
                        />
                    </group>
                    <group name="transport_means">
                        <field name="l10n_tr_driver_id"
                               domain="[('l10n_tr_is_driver','=',True)]"
                               context="{'default_l10n_tr_is_driver': True}"
                               attrs="{'readonly': [('state', 'in',
                               ('done', 'cancel'))]}"
                        />
                        <field name="l10n_tr_vehicle_license_plate"
                               attrs="{'readonly': [('state', 'in',
                               ('done', 'cancel'))]}"
                        />
                        <field name="l10n_tr_trailer_plate_no"
                               attrs="{'readonly': [('state', 'in',
                               ('done', 'cancel'))]}"
                        />
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <record id="stock_picking_list_inherit_delivery" model="ir.ui.view">
        <field name="name">stock.picking.tree.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="before">
                <field name="l10n_tr_driver_id" optional="hide"/>
                <field name="l10n_tr_transporter_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
