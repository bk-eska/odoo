<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sales_order_filter_route" model="ir.ui.view">
        <field name="name">sale.order.search.route</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='customer']" position="after">
                <filter name="route" string="Route" domain="[]" context="{'group_by':'partner_route_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_route_id" model="ir.ui.view">
        <field name="name">sale.order.form.route.id</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_route_id"/>
            </xpath>
        </field>
    </record>
</odoo>