<odoo>
    <template id="account_invoice_report_template_qr"
              inherit_id="account.report_invoice_document">
        <xpath expr="//p[@name='note']" position="after">
            <t t-if="o.invoice_qr_code">
                <div style="width:100px;height:100px;float:left;">
                    <td colspan="99">
                        <img t-att-src="'data:image/png;base64,' + o.invoice_qr_code.decode('utf-8')"
                             alt="QR Code"
                             style="width:100px; height:100px; float:left;"/>
                    </td>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
