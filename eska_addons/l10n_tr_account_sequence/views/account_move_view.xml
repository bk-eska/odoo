<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_sequence" model="ir.ui.view">
        <field name="name">account.move.form.sequence</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_incoterm_id']" position="before">
                <field name="l10n_tr_move_sequence_number"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree//field[@name='account_id']" position="before">
                <field name="l10n_tr_line_sequence_number" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_tree_sequence" model="ir.ui.view">
        <field name="name">account.move.tree.sequence</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="l10n_tr_move_sequence_number" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_sequence" model="ir.ui.view">
        <field name="name">account.move.line.tree.sequence</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="l10n_tr_line_sequence_number" optional="show"/>
            </xpath>
        </field>
    </record>


    <record id="view_move_line_form_sequence" model="ir.ui.view">
        <field name="name">account.move.line.form.sequence</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="before">
                <field name="l10n_tr_move_sequence_number"/>
                <field name="l10n_tr_line_sequence_number"/>
            </xpath>
        </field>
    </record>
</odoo>
