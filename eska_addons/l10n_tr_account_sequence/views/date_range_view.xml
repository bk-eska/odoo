<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_date_range_form_view_sequence" model="ir.ui.view">
        <field name="name">date.range.form.sequence</field>
        <field name="model">date.range</field>
        <field name="inherit_id" ref="date_range.view_date_range_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <label for="l10n_tr_move_sequence_number_start" string="Move Sequence Number"/>
                <div>
                    <field name="l10n_tr_move_sequence_number_start" class="oe_inline" nolabel="1"/> -
                    <field name="l10n_tr_move_sequence_number_stop" nolabel="1" class="oe_inline"/>
                </div>
                <label for="l10n_tr_line_sequence_number_start" string="Line Sequence Number"/>
                <div>
                    <field name="l10n_tr_line_sequence_number_start" class="oe_inline" nolabel="1"/> -
                    <field name="l10n_tr_line_sequence_number_stop" nolabel="1" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_date_range_tree_sequence" model="ir.ui.view">
        <field name="name">date.range.tree.sequence</field>
        <field name="model">date.range</field>
        <field name="inherit_id" ref="date_range.view_date_range_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="l10n_tr_move_sequence_number_start"/>
                <field name="l10n_tr_move_sequence_number_stop"/>
                <field name="l10n_tr_line_sequence_number_start"/>
                <field name="l10n_tr_line_sequence_number_stop"/>
            </xpath>
        </field>
    </record>
</odoo>
