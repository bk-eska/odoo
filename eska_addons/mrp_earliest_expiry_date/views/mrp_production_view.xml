<odoo>
    <record id="stock_production_expiration_date" model="ir.ui.view">
        <field name="name">mrp.production.expiration.date</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='components_availability']" position="before">
                <field name="earliest_expiry_date" attrs="{'invisible': [('earliest_expiry_date', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>


