<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_tree_reporting" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.reporting</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount']" position="after">
                    <field name="report_currency_id" invisible="1"/>
                    <field name="report_currency_amount"/>
                </xpath>
            </field>
    </record>
</odoo>