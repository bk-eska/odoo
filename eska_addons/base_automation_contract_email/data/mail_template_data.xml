<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="email_contract_ending_reminder_template" model="mail.template">
        <field name="name">Contract Ending Reminder</field>
        <field name="model_id" ref="contract.model_contract_contract"/>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email or user.email_formatted) }}</field>
        <field name="email_to">{{ object.partner_id.email_formatted }}</field>
        <field name="subject">{{ object.company_id.name }} Contract Reminder - {{ object.name }} / {{ object.partner_id.commercial_company_name }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.partner_id.name or ''"/>,
                    <br />
                </p>
                <p>
                    We would like to remind you that the contract between us is about to expire in 7 days.
                    Do not hesitate to contact us.
                </p>
                <p>
                    Best Regards,
                    <t t-if="not is_html_empty(object.user_id.signature)">
                        <br />
                        <t t-out="object.user_id.signature"/>
                    </t>
                    <t t-else="">
                        <br />
                        --
                        <br />
                        <t t-out="object.user_id.name"/>
                    </t>
                </p>
            </div>
        </field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>