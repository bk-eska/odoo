<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_invoice_form_account_unit_price" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit.price.unit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='price_unit']" position="after">
                <field name="price_unit_editable" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='price_unit']" position="attributes">
                <attribute name="attrs">{'readonly': [('price_unit_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="after">
                <field name="price_unit_editable" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="attributes">
                <attribute name="attrs">{'readonly': [('price_unit_editable', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>