<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_einvoice_stock" model="ir.ui.view">
        <field name="name">account.move.form.einvoice.stock</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_tr_einvoice_postbox_id']" position="after">
                <field name="l10n_tr_einvoice_despatch_ids"
                       attrs="{'invisible':[('move_type','not in', ['out_invoice', 'in_refund'])]}"
                       domain="[('id', 'in', picking_ids), ('picking_type_code', '=', 'outgoing'),]"
                       widget="many2many_tags"
                       options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
            </xpath>
        </field>
    </record>
</odoo>
