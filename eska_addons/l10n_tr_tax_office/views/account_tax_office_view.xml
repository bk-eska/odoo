<odoo>
    <record id="view_tax_office_search" model="ir.ui.view">
        <field name="name">account.tax.office.search</field>
        <field name="model">account.tax.office</field>
        <field name="arch" type="xml">
            <search string="Tax Offices">
                <field name="name"
                       filter_domain="['|', ('name','ilike',self),
                       ('code','ilike',self)]"
                       string="Tax Office"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <field name="state_id"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="groupby_product" domain="[]" context="{'group_by': 'state_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tax_office_tree" model="ir.ui.view">
        <field name="name">account.tax.office.tree</field>
        <field name="model">account.tax.office</field>
        <field name="arch" type="xml">
            <tree string="Tax Offices">
                <field name="state_id"/>
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="view_tax_office_form" model="ir.ui.view">
        <field name="name">account.tax.office.form</field>
        <field name="model">account.tax.office</field>
        <field name="arch" type="xml">
            <form string="Tax Office">
                <sheet>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="state_id"/>
                        </group>
                        <group>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tax_office" model="ir.actions.act_window">
        <field name="name">Tax Offices</field>
        <field name="res_model">account.tax.office</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_tax_office" action="action_tax_office"
              parent="account.account_account_menu" sequence="3"/>
</odoo>
