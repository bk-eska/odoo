<odoo>
  <record id="view_account_position_form_export" model="ir.ui.view">
      <field name="name">account.fiscal.position.form.export</field>
      <field name="model">account.fiscal.position</field>
      <field name="inherit_id" ref="account.view_account_position_form"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='l10n_tr_fp_type']" position="after">
              <field name="l10n_tr_default_export_type"
                     attrs="{'invisible':[('l10n_tr_fp_code', '!=', '301')]}"/>
          </xpath>
      </field>
  </record>
</odoo>
