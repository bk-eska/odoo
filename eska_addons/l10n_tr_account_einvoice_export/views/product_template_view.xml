<odoo>
    <data>
        <record id="product_template_form_view_origin" model="ir.ui.view">
            <field name="name">product.template.common.form.einvoice</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="account.product_template_form_view"/>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='property_account_income_id']"
                       position="after">
                    <field name="l10n_tr_einvoice_shipment_cost"
                           groups="account.group_account_readonly"/>
                    <field name="l10n_tr_einvoice_insurance_cost"
                           groups="account.group_account_readonly"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

