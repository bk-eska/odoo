<odoo>
    <record id="assign_view_form_helpdesk" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="after">
                <label for="knowledge_base_id" string="Knowledge Base"/>
                <field name='knowledge_base_id'/>
                <br/>
                <label for="solution" string="Solution"/>
                <field name='solution'/>
            </xpath>
        </field>
    </record>
</odoo>
