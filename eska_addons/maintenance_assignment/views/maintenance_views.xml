<odoo>
    <record id="view_maintenance_equipment_assign_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.assign.form</field>
        <field name="model">maintenance.equipment.assign</field>
        <field name="arch" type="xml">
            <form string="Maintenance Equipment Assignment">
                <header>
                    <button name="action_assign" string="Assign" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_return_form" string="Return Equipments" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'assigned')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="employee_id" class="oe_edit_only"/>
                        <h1><field name="employee_id" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                    <field name="equipment_ids" widget="many2many" attrs="{'readonly': [('state', 'in', ['assigned'])]}"/>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_maintenance_equipment_assign_tree" model="ir.ui.view">
        <field name="name">maintenance.equipment.assign.tree</field>
        <field name="model">maintenance.equipment.assign</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Equipment Assignment">
                <field name="employee_id"/>
                <field name="equipment_ids"/>
                <field name="date"/>
                <field name="company_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_maintenance_equipment_return_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.return.form</field>
        <field name="model">maintenance.equipment.return</field>
        <field name="arch" type="xml">
            <form string="Maintenance Equipment Return">
                <header>
                    <button name="action_return" string="Return" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="employee_id" class="oe_edit_only"/>
                        <h1><field name="employee_id" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                        <field name="equipment_ids" widget="many2many" attrs="{'readonly': [('state', 'in', ['returned'])]}"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_maintenance_equipment_return_tree" model="ir.ui.view">
        <field name="name">maintenance.equipment.return.tree</field>
        <field name="model">maintenance.equipment.return</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Equipment Return">
                <field name="employee_id"/>
                <field name="equipment_ids"/>
                <field name="date"/>
                <field name="company_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_maintenance_equipment_assign_tree" model="ir.actions.act_window">
        <field name="name">Assign Equipment</field>
        <field name="res_model">maintenance.equipment.assign</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_maintenance_equipment_return_tree" model="ir.actions.act_window">
        <field name="name">Return Equipment</field>
        <field name="res_model">maintenance.equipment.return</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_equipment_assignment_main" name="Equipment Assignment"
      parent="maintenance.menu_maintenance_title"
      action="action_maintenance_equipment_assign_tree"
      groups="base.group_user"
      sequence="4"/>

    <menuitem id="menu_equipment_assignments_tree" name="Assign Equipment"
          parent="menu_equipment_assignment_main"
          action="action_maintenance_equipment_assign_tree"
          groups="base.group_user"
          sequence="1"/>

    <menuitem id="menu_maintenance_equipment_return_tree" name="Return Equipment"
          parent="menu_equipment_assignment_main"
          action="action_maintenance_equipment_return_tree"
          groups="base.group_user"
          sequence="2"/>
</odoo>