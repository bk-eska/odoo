<odoo>
    <record model="ir.ui.view"
            id="view_account_payment_form_currency_fixed_rate">
        <field name="name">account.payment.form.currency.fixed.rate</field>
        <field name="model">account.payment</field>
        <field name="inherit_id"
               ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_rate']"
                   position="attributes">
                <attribute name="attrs">
                    {'invisible':['|',
                    ('currency_rate_method','=', 'fixed_rate'),
                    ('use_inverse_rate','=',True)]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='currency_inverse_rate']"
                   position="attributes">
                <attribute name="attrs">
                    {'invisible':['|',
                    ('currency_rate_method','=', 'fixed_rate'),
                    ('use_inverse_rate','=',False)]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='currency_rate']"
                   position="after">
                <field name="custom_rate"
                       nolabel="1"
                       class="oe_inline"
                       attrs="{'invisible': ['|',
                       ('currency_rate_method','!=', 'fixed_rate'),
                       ('use_inverse_rate','=',True)],
                       'readonly':[('state','!=','draft')]}"/>
                 <field name="custom_inverse_rate"
                       nolabel="1"
                       class="oe_inline"
                       attrs="{'invisible': ['|',
                       ('currency_rate_method','!=', 'fixed_rate'),
                       ('use_inverse_rate','=',False)],
                       'readonly':[('state','!=','draft')]}"/>
            </xpath>
        </field>
    </record>
</odoo>




