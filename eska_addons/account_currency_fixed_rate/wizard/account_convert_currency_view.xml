<odoo>
    <record model="ir.ui.view"
            id="view_account_convert_currency_currency_rate_type">
        <field name="name">account.convert.currency.form.rate.type</field>
        <field name="model">account.convert.currency</field>
        <field name="inherit_id"
               ref="account_currency_rate.view_account_convert_currency"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_rate']"
                   position="attributes">
                <attribute name="attrs">
                    {'invisible':['|',
                    ('currency_rate_method','=', 'fixed_rate'),
                    ('use_inverse_rate','=',True)]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='currency_inverse_rate']"
                   position="attributes">
                <attribute name="attrs">
                    {'invisible':['|',
                    ('currency_rate_method','=', 'fixed_rate'),
                    ('use_inverse_rate','=',False)]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='currency_rate']"
                   position="after">
                <field name="custom_rate"
                       nolabel="1"
                       class="oe_inline"
                       attrs="{'invisible': ['|',
                       ('currency_rate_method','!=', 'fixed_rate'),
                       ('use_inverse_rate','=',True)]}"/>
                <field name="custom_inverse_rate"
                       nolabel="1"
                       class="oe_inline"
                       attrs="{'invisible': ['|',
                       ('currency_rate_method','!=', 'fixed_rate'),
                       ('use_inverse_rate','=',False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>




