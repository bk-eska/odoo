<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_operation_tree_production" model="ir.ui.view">
        <field name="name">stock.move.line.inherit.tree.production</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="production_date" force_save="1" attrs="{
                    'column_invisible': ['|', ('parent.product_id.tracking', '=','none'), ('parent.picking_code', '!=', 'incoming')],
                    'readonly': [('picking_type_use_existing_lots', '!=', False)],
                }"/>
            </xpath>
        </field>
    </record>
    <record id="view_stock_move_line_detailed_operation_tree_production" model="ir.ui.view">
        <field name="name">stock.move.line.operations.inherit.tree.production</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="production_date" force_save="1" attrs="{
                    'column_invisible': [('parent.picking_type_code', '!=', 'incoming')],
                    'readonly': [('picking_type_use_existing_lots', '!=', False)],
                }"/>
            </xpath>
        </field>
    </record>
</odoo>
