<odoo>
    <record model="ir.ui.view" id="sale_order_view_form">
        <field name="name">sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_reporting']" position="attributes">
                <attribute name="groups"/>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="sale_crm_view_form">
        <field name="name">sale.crm.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_crm.sale_view_inherit123"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='opportunity_id']" position="attributes">
                <attribute name="groups"/>
            </xpath>
        </field>
    </record>
</odoo>
