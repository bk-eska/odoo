<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="loyalty_reward_view_form_deposit" model="ir.ui.view">
        <field name="name">loyalty.reward.view.form.deposit</field>
        <field name="model">loyalty.reward</field>
        <field name="inherit_id" ref="loyalty.loyalty_reward_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reward_type']" position="after">
                 <field name="deposit" attrs="{'invisible': [('reward_type', '!=', 'product')]}"/>/>
            </xpath>
        </field>
    </record>
</odoo>