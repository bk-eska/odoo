<odoo>
    <record id="view_personal_information_kimlik" model="ir.ui.view">
        <field name="name">TC Kimlik: personal info</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_contact_personal_info.contact_personal_information_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='gender']" position="attributes">
                <attribute name="attrs">{'required':[('kimlik_turu','in',['TCKK', 'TCNC'])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='father_name']" position="attributes">
                <attribute name="attrs">{'required':[('kimlik_turu','in',['TCKK', 'TCNC'])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='mother_name']" position="attributes">
                <attribute name="attrs">{'required':[('kimlik_turu','in',['TCKK', 'TCNC'])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='birth_date']" position="attributes">
                <attribute name="attrs">{'required':[('kimlik_turu','in',['TCKK', 'TCNC'])]}</attribute>
            </xpath>
            <xpath expr="//group[@name='personal_information_group']" position="before">
                <group name="kimlik">
                    <field name="kimlik_turu"/>
                    <field name='kimlik_seri_no' attrs="{'required':[('kimlik_turu','=','TCKK')]}"/>
                    <field name="yabanci_kimlik_no"
                           attrs="{'required':[('kimlik_turu','in',['TCYK', 'TCPC'])],
                           'invisible':[('kimlik_turu','not in',['TCYK', 'TCPC'])]}"/>
                    <field name='kimlik_tckn'
                           attrs="{'required':[('kimlik_turu','in',['TCKK', 'TCNC', 'TCSC'])],
                           'invisible':[('kimlik_turu','not in',['TCKK', 'TCNC', 'TCSC'])]}"/>
                    <field name="nvi_validate"/>
                    <button name="action_nvi_validate"
                            type="object"
                            class="ms-4 btn-link"
                            string="Verify"
                            icon="fa-arrow-right"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='personal_information_group']" position="after">
                <group attrs="{'invisible':[('kimlik_turu','!=','TCNC')]}">
                    <field name='kimlik_il'
                           attrs="{'required':[('kimlik_turu','=','TCNC')]}"/>
                    <field name='kimlik_ilce'
                           attrs="{'required':[('kimlik_turu','=','TCNC')]}"/>
                    <field name='kimlik_mahalle'
                           attrs="{'required':[('kimlik_turu','=','TCNC')]}"/>
                    <field name='kimlik_cilt_no'
                           attrs="{'required':[('kimlik_turu','=','TCNC')]}"/>
                    <field name='kimlik_kutuk_no'
                           attrs="{'required':[('kimlik_turu','=','TCNC')]}"/>
                    <field name='kimlik_sayfa_no'
                           attrs="{'required':[('kimlik_turu','=','TCNC')]}"/>
                    <field name='kimlik_verildigi_yer'
                           attrs="{'required':[('kimlik_turu','=','TCNC')]}"/>
                    <field name='kimlik_verildigi_tarih'
                           attrs="{'required':[('kimlik_turu','=','TCNC')]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
