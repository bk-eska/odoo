<odoo>
    <record id="mrp_production_form_view_production_date" model="ir.ui.view">
        <field name="name">mrp.production.form.production.date</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='components_availability']" position="before">
                <field name="production_date"
                       attrs="{'readonly': [('state', 'not in', ['draft', 'confirmed'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>


