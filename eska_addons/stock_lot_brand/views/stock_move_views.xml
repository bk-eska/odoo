<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_operations_lot_brand" model="ir.ui.view">
        <field name="name">stock.move.operations.inherit.form</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after" >
                <field name="picking_code" invisible="1"/>
                <field name="brand_on_lot" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_stock_move_line_operation_tree_lot_brand" model="ir.ui.view">
        <field name="name">stock.move.line.inherit.tree.production</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="picking_type_use_existing_lots" invisible="1"/>
                <field name="lot_brand_id" force_save="1" attrs="{
                    'column_invisible': ['|', ('parent.brand_on_lot', '=', False), ('parent.picking_code', '!=', 'incoming')],
                    'readonly': [('picking_type_use_existing_lots', '!=', False)],
                }"/>
            </xpath>
        </field>
    </record>
    <record id="view_stock_move_line_detailed_operation_tree_lot_brand" model="ir.ui.view">
        <field name="name">stock.move.line.operations.inherit.tree.production</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="picking_type_use_existing_lots" invisible="1"/>
                <field name="lot_brand_id" force_save="1" attrs="{
                    'column_invisible': [('parent.picking_type_code', '!=', 'incoming')],
                    'readonly': [('picking_type_use_existing_lots', '!=', False)],
                }"/>
            </xpath>
        </field>
    </record>
</odoo>
