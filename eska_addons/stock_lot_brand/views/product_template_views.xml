<odoo>
    <record id="product_template_form_view_lot_brand" model="ir.ui.view">
        <field name="name">product.template.common.form.origin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <group name="traceability" position="inside">
                <field name="brand_on_lot"
                       attrs="{'invisible': [('tracking', '=','none')]}"/>
            </group>
            <xpath expr="//field[@name='product_brand_id']" position="after">
                <field name="brand_invisible" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_brand_id']"
                   position="attributes">
                <attribute name="attrs">{'invisible':[('brand_invisible','=',True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>

