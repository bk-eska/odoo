<odoo>
    <record id="view_move_form_lot_brand" model="ir.ui.view">
        <field name="name">stock.production.lot.inherit.form.lot.brand</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
        <xpath expr="//field[@name='product_id']" position="after">
                <field name="brand_on_lot" invisible="1"/>
                <field name="product_brand_id"
                       attrs="{'readonly': [('brand_on_lot', '=', False)]}"
                />
        </xpath>
        </field>
    </record>

    <record id="view_production_lot_view_tree_lot_brand" model="ir.ui.view">
        <field name="name">stock.production.lot.tree.lot.brand</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_brand_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_view_search_lot_brand" model="ir.ui.view">
        <field name="name">Production Lots Filter Brand Lot</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_by_product']" position="after">
                <filter name="group_by_brand"
                        string="Brand"
                        domain="[]"
                        context="{'group_by': 'product_brand_id'}"
                />
            </xpath>
        </field>
    </record>

</odoo>
