<odoo>
        <record id="view_hr_occupation_tree" model="ir.ui.view">
            <field name="name">hr.hr.occupation.tree</field>
            <field name="model">hr.occupation</field>
            <field name="arch" type="xml">
                <tree string="Occupations">
                    <field name="code"/>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_occupation_form" model="ir.ui.view">
            <field name="name">hr.hr.occupation.form</field>
            <field name="model">hr.occupation</field>
            <field name="arch" type="xml">
                <form string="Occupations">
                    <sheet>
                        <div class="oe_title">
                            <label class="oe_edit_only" for="name"/>
                            <field name="name"/>
                        </div>
                        <group>
                            <field name="code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_occupations" model="ir.actions.act_window">
            <field name="name">Occupations</field>
            <field name="res_model">hr.occupation</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_occupations"
                  action="action_occupations"
                  parent="hr.menu_human_resources_configuration"
                  name="Occupations"
                  groups="base.group_user"
                  sequence="3" />
</odoo>
