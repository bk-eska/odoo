<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_einvoice" model="ir.ui.view">
        <field name="name">account.move.form.einvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="after">
                <page string="E-Invoice" attrs="{'invisible':[('l10n_tr_delivery_type','not in',['einvoice', 'earchive'])]}">
                    <group name="einvoice">
                        <group>
                            <field name="l10n_tr_einvoice_sequence"
                                   attrs="{'invisible':[('move_type','not in', ['out_invoice', 'in_refund'])],
                                   'required':['&amp;',('l10n_tr_delivery_type','in',['einvoice', 'earchive']),('move_type','in', ['out_invoice', 'in_refund'])]}"
                                   domain="[('active', '=', True),('company_id', '=', company_id),('code', '=', 'account.' + l10n_tr_delivery_type)]"
                                   options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                            <field name="l10n_tr_einvoice_uuid" attrs="{'invisible':[('l10n_tr_einvoice_uuid','=', False)]}"/>
                            <field name="l10n_tr_einvoice_envelope_uuid" attrs="{'invisible':[('l10n_tr_einvoice_envelope_uuid','=', False)]}"/>
                            <field name="l10n_tr_einvoice_response_uuid" attrs="{'invisible':[('l10n_tr_einvoice_response_uuid','=', False)]}"/>
                            <field name="l10n_tr_einvoice_state" attrs="{'readonly':['|',('l10n_tr_einvoice_state','not in', ['waiting', 'failed']),('move_type','not in', ['out_invoice', 'in_refund'])]}" force_save="1"/>
                            <field name="commercial_partner_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="l10n_tr_einvoice_profile"
                                   attrs="{'required':[('l10n_tr_delivery_type','=','einvoice')],
                                   'invisible':[('l10n_tr_delivery_type','!=','einvoice')]}"/>
                            <field name="l10n_tr_einvoice_sender_id"
                                   attrs="{'required':[('l10n_tr_delivery_type','=','einvoice')],
                                   'invisible':[('l10n_tr_delivery_type','!=','einvoice')]}"
                                   options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                            <field name="l10n_tr_einvoice_postbox_id"
                                   attrs="{'required':[('l10n_tr_delivery_type','=','einvoice')],
                                   'invisible':[('l10n_tr_delivery_type','!=','einvoice')]}"
                                   options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//button[@name='action_invoice_sent']" position="before">
                <button name="action_einvoice_accept"
                        type="object"
                        string="Accept"
                        attrs="{'invisible':['|',
                        ('l10n_tr_einvoice_state','!=','waiting'),
                        ('move_type','!=', 'in_invoice')]}"
                        class="oe_highlight"
                        groups="account.group_account_invoice"/>
                <button name="action_einvoice_reject"
                        type="object"
                        string="Reject"
                        attrs="{'invisible':['|',
                        ('l10n_tr_einvoice_state','!=','waiting'),
                         ('move_type','!=', 'in_invoice')]}"
                        class="oe_highlight"
                        groups="account.group_account_invoice"/>
                <button name="action_einvoice_resend"
                        type="object"
                        string="Resend"
                        attrs="{'invisible':['|',
                        ('l10n_tr_einvoice_state','!=','failed'),
                        ('move_type','not in', ['out_invoice', 'in_refund'])]}"
                        class="oe_highlight"
                        groups="account.group_account_invoice"/>
                <button name="action_einvoice_get_status"
                        type="object"
                        string="Get Status"
                        attrs="{'invisible':[('l10n_tr_einvoice_state','not in', ['sent', 'failed'])]}"
                        class="oe_highlight"
                        groups="account.group_account_invoice"/>
            </xpath>
            <!-- readonly on outgoing invoices -->
            <xpath expr="//group/group/field[@name='l10n_tr_document_number']"
                   position="attributes">
                <attribute name="attrs">{'invisible':['|', '|',
                    ('l10n_tr_use_document', '=', False),
                    '&amp;',
                    ('move_type', '=', 'entry'),
                    ('l10n_tr_document_type','=',False),
                    '&amp;','&amp;',
                    ('l10n_tr_delivery_type','in',['einvoice', 'earchive']),
                    ('move_type','in',['out_invoice', 'in_refund']),
                    ('state','=','draft')],
                    'required':[('l10n_tr_document_type','!=',False),
                    ('move_type','=','entry')]}
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_einvoice" model="ir.ui.view">
        <field name="name">account.move.tree.einvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="l10n_tr_einvoice_state"/>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_tree_einvoice" model="ir.ui.view">
          <field name="name">account.move.supplier.document.tree</field>
          <field name="model">account.move</field>
          <field name="inherit_id" ref="account.view_in_invoice_tree"/>
          <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="l10n_tr_einvoice_state"/>
            </xpath>
          </field>
    </record>

    <record id="view_account_invoice_filter_einvoice" model="ir.ui.view">
        <field name="name">account.move.select.einvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='status']" position="after">
                <filter string="E-Invoice Status" name="l10n_tr_einvoice_state"
                        context="{'group_by':'l10n_tr_einvoice_state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
