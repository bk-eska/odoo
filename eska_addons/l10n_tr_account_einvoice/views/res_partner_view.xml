<odoo>
    <record id="view_partner_form_einvoice" model="ir.ui.view">
        <field name="name">res.partner.form.einvoice</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="E-Invoice"
                      attrs="{'invisible': [('l10n_tr_einvoice_user','=',False)]}">
                    <group>
                        <group>
                            <field name="l10n_tr_default_einvoice_profile"/>
                            <field name="l10n_tr_default_einvoice_postbox"
                                   options="{'no_open': True,'no_create': 1,
                                   'no_create_edit': 1}"/>
                        </group>
                        <group>
                            <field name="l10n_tr_einvoice_user"
                                   invisible="1"/>
                            <field name="l10n_tr_einvoice_import_invoice_lines"/>
                        </group>
                    </group>
                    <group>
                        <group string="Senders">
                            <field name="l10n_tr_einvoice_sender_ids"
                                   colspan="2"
                                   nolabel="1">
                                <tree string="Senders">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Postboxes">
                            <field name="l10n_tr_einvoice_postbox_ids"
                                   colspan="2"
                                   nolabel="1">
                                <tree string="Postboxes">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
