<odoo>
    <record id="view_company_form_einvoice" model="ir.ui.view">
        <field name="name">res.company.form.einvoice</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="E-Invoice"
                      attrs="{'invisible':[('l10n_tr_use_document', '=', False)]}">
                    <group>
                        <group>
                            <field name="l10n_tr_einvoice_enabled"/>
                        </group>
                        <group attrs="{'invisible':[('l10n_tr_einvoice_enabled', '=', False)]}">
                            <field name="l10n_tr_einvoice_user_download"/>
                            <field name="l10n_tr_einvoice_import_invoice_lines"/>
                            <field name="l10n_tr_earchive_auto_email"/>
                        </group>
                        <group string="Senders"
                               attrs="{'invisible':[('l10n_tr_einvoice_enabled',
                                   '=', False)]}">
                            <field name="l10n_tr_einvoice_sender_ids"
                                   colspan="2"
                                   nolabel="1">
                                <tree string="Senders"
                                      editable="bottom">
                                    <field name="name"/>
                                    <field name="date_last_check"/>
                                    <button name="get_responses"
                                            type="object"
                                            string="Get Responses"
                                            class="oe_highlight"/>
                                    <button name="update_invoices"
                                            type="object"
                                            string="Update Invoices"
                                            class="oe_highlight"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Postboxes"
                               attrs="{'invisible':[('l10n_tr_einvoice_enabled',
                                   '=', False)]}">
                            <field name="l10n_tr_einvoice_postbox_ids"
                                   colspan="2"
                                   nolabel="1">
                                <tree string="Postboxes"
                                      editable="bottom">
                                    <field name="name"/>
                                    <field name="journal_id"
                                           domain="[('type', '=', 'purchase')]"/>
                                    <field name="date_last_check"/>
                                    <button name="get_invoices"
                                            type="object"
                                            string="Get Invoices"
                                            class="oe_highlight"/>
                                    <button name="update_invoices"
                                            type="object"
                                            string="Update Invoices"
                                            class="oe_highlight"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
