<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="l10n_tr_einvoice_postbox_rule" model="ir.rule">
        <field name="name">E-Invoice Postboxes Rule</field>
        <field name="model_id" ref="model_l10n_tr_einvoice_postbox"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="l10n_tr_einvoice_sender_rule" model="ir.rule">
        <field name="name">E-Invoice Senders Rule</field>
        <field name="model_id" ref="model_l10n_tr_einvoice_sender"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
