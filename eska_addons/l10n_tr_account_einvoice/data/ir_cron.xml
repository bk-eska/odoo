<odoo noupdate="1">
    <record forcecreate="True" id="ir_cron_einvoice_get_invoices_action" model="ir.cron">
        <field name="name">E-Invoice Get Invoices</field>
        <field name="model_id" ref="model_res_company"/>
        <field name="state">code</field>
        <field name="code">model.run_get_einvoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>
    <record forcecreate="True" id="ir_cron_einvoice_get_responses_action" model="ir.cron">
        <field name="name">E-Invoice Get Responses</field>
        <field name="model_id" ref="model_res_company"/>
        <field name="state">code</field>
        <field name="code">model.run_get_responses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>
    <record forcecreate="True" id="ir_cron_einvoice_update_invoices_action" model="ir.cron">
        <field name="name">E-Invoice Update Status Of Invoices</field>
        <field name="model_id" ref="model_res_company"/>
        <field name="state">code</field>
        <field name="code">model.run_update_einvoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>
    <record forcecreate="True" id="ir_cron_einvoice_get_registered_users_action" model="ir.cron">
        <field name="name">E-Invoice Get Registered Users</field>
        <field name="model_id" ref="model_res_company"/>
        <field name="state">code</field>
        <field name="code">model.run_get_registered_users()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
