<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_stock_quant_tree_reporting_value" model="ir.ui.view">
        <field name="name">stock.quant.tree.reporting.value</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value']" position="after">
                <field name="report_currency_id" invisible="1"/>
                <field name="report_currency_value"
                       widget="monetary"
                       options="{'currency_field': 'report_currency_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable_reporting_value" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.reporting.value</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value']" position="after">
                <field name="report_currency_id" invisible="1"/>
                <field name="report_currency_value"
                       widget="monetary"
                       options="{'currency_field': 'report_currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>