<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_tree_view_report_currency" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.report.currency</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="report_currency_id" invisible="1"/>
                <field name="report_currency_standard_price"
                       widget='monetary'
                       options="{'currency_field': 'report_currency_id'}"
                       optional="show"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_report_currency" model="ir.ui.view">
        <field name="name">product.template.form.inherit.report.currency</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <field name="report_currency_id" invisible="1"/>
                <label for="report_currency_standard_price"
                       attrs="{'invisible': [('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}"/>
                <div name="report_currency_standard_price_uom"
                     attrs="{'invisible': [('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}">
                    <field name="report_currency_standard_price"
                           class="oe_inline"
                           widget='monetary'
                           options="{'currency_field': 'report_currency_id', 'field_digits': True}"/>
                    <span groups="uom.group_uom" class="oe_read_only">per
                        <field name="uom_name"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>