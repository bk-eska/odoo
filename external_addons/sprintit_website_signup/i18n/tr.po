#. module: sprintit_website_signup
#: model:mail.template,body_html:sprintit_website_signup.mail_template_user_signup_account_rejected
msgid ""
"<div style=\"padding:0px;width:600px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777\">\n"
"                <p>Dear ${object.name},</p>\n"
"                <p>\n"
"                    Your account has been Rejected! , For more detail contact us.\n"
"                </p>\n"
"                <p>Best regards,</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"padding:0px;width:600px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777\">\n"
"                <p>Sayın ${object.name},</p>\n"
"                <p>\n"
"                    Hesabınız reddedilmiştir! , Daha fazla bilgi için bizimle iletişime geçiniz.\n"
"                </p>\n"
"                <p>Saygılarımızla,</p>\n"
"            </div>\n"
"        "

#. module: sprintit_website_signup
#: model:mail.template,body_html:sprintit_website_signup.mail_template_user_signup_account_approved
msgid ""
"<div style=\"padding:0px;width:600px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777\">\n"
"                <p>Dear ${object.name},</p>\n"
"                <p>\n"
"                    Your account has been approved!\n"
"                </p>\n"
"                <div style=\"text-align: center; margin-top: 16px;\">\n"
"                    <a href=\"/web/login?%24%7Bctx%5B'auth_login'%5D%7D\" style=\"padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#875A7B; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius:3px\">\n"
"                        Go to My Account\n"
"                    </a>\n"
"                </div>\n"
"                <p>Best regards,</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"padding:0px;width:600px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777\">\n"
"                <p>Sayın ${object.name},</p>\n"
"                <p>\n"
"                    Hesabınız onaylanmıştır!\n"
"                </p>\n"
"                <div style=\"text-align: center; margin-top: 16px;\">\n"
"                    <a href=\"/web/login?${ctx['auth_login']}\" style=\"padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#875A7B; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius:3px\">\n"
"                        Hesabıma Git\n"
"                    </a>\n"
"                </div>\n"
"                <p>Saygılarımızla,</p>\n"
"            </div>\n"
"        "

#. module: sprintit_website_signup
#: model:mail.template,body_html:sprintit_website_signup.mail_template_user_signup_approval
msgid ""
"<div style=\"padding:0px;width:600px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777\">\n"
"                <p>Dear Approval Team,</p>\n"
"                <p>\n"
"                    New user <strong>${object.name}</strong> with email <strong>${object.email}</strong> is signup.Review his profile and take appropriate action.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"padding:0px;width:600px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777\">\n"
"                <p>Sayın Onaylama Ekibi,</p>\n"
"                <p>\n"
"                    Yeni kullanıcı <strong>${object.name}</strong>, <strong>${object.email}</strong> e-postasıyla kaydoldu. Profili değerlendirip uygun aksiyonu alınız.\n"
"                </p>\n"
"            </div>\n"
"        "

