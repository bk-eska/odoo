<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="view_mode" eval="'tree,kanban,form'"/>
    </record>

    <record model="ir.ui.view" id="product_template_kanban_view_hide_price">
        <field name="name">product.template.kanban.view.hide.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='product_lst_price']" position="replace"/>
        </field>
    </record>

</odoo>
