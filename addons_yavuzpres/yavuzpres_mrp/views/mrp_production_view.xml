<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_production_tree_view_yavuzpres" model="ir.ui.view">
        <field name="name">mrp.production.tree.view.yavuzpres</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="reference" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='reservation_state']" position="after">
                <field name="qty_produced"/>
                <field name="qty_remaining"/>
                <field name="qty_initial" sum="Total Initial Qty" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_form_view_yavuzpres" model="ir.ui.view">
        <field name="name">mrp.production.form.view.yavuzpres</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="reference"/>
            </xpath>
            <xpath expr="//field[@name='product_qty']/parent::div" position="after">
                <field name="backorder_sequence" invisible="1"/>
                <field name="qty_initial" force_save="1" attrs="{'invisible': [('backorder_sequence', '=', 0)]}"/>
                <field name="calculated_prod_qty"
                       attrs="{'invisible': [('calculated_prod_qty', '=', 0)]}"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']//field[@name='product_id']" position="after">
                <field name="categ_id"/>
            </xpath>
            <xpath expr="//group" position="before">
                <div>
                    <field name="image_1920" widget="image" class="float-end oe_avatar bg-view"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/tree//field[@name='product_id']" position="before">
                <field name="image_1920"
                       widget="image"
                       class="float-start oe_avatar"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_filter_yavuzpres" model="ir.ui.view">
        <field name="name">mrp.production.select.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_ready']" position="after">
                <filter name="printed" string="Rapor Yazdırılanlar" domain="[('report_printed', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>