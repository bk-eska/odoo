    <record id="action_report_production_order_yavuzpres" model="ir.actions.report">
        <field name="name">Yavuzpres Production Order</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">yavuzpres_mrp.report_mrporder_yavuzpres</field>
        <field name="report_file">yavuzpres_mrp.report_mrporder_yavuzpres</field>
        <field name="print_report_name">'Yavuzpres Production Order - %s' % object.name</field>
        <field name="binding_model_id" ref="model_mrp_production"/>
        <field name="binding_type">report</field>
    </record>

