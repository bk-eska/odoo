<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sale_stock_yavuzpres" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.yavuzpres</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order'][2]" position="after">
                <xpath expr="//label[@for='commitment_date']" position="move"/>
                <xpath expr="//field[@name='commitment_date']/parent::div" position="move"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="total_qty_ordered"/>
            </xpath>
        </field>
    </record>
</odoo>
