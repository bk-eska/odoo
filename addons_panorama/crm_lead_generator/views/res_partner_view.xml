<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form_inherit_duration" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.duration</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']/group" position="inside">
                <group string="Leads" name="crm_lead">
                    <label for="schedule_duration"/>
                    <div class="o_row" name="schedule_duration">
                        <field name="schedule_duration" nolabel="1"/>
                        <span>days</span>
                    </div>
                    <field name="date_last_opportunity"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_last_opportunity_date" model="ir.ui.view">
        <field name="name">res.partner.filter.last.opportunity.date</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Need Scheduling"
                        name="need_scheduling"
                        domain="['|',
                                ('date_last_opportunity', '&lt;', context_today().strftime('%Y-%m-%d')),
                                ('date_last_opportunity', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
