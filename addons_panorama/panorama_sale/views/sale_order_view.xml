<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_is_return" model="ir.ui.view">
        <field name="name">sale.order.form.view.is.return</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="is_return"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="after">
                <field name="missing_items" widget="boolean_toggle" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_panaroma" model="ir.ui.view">
        <field name="name">sale.order.list.select</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>