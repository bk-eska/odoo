<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_content_missing_items" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='total']" position="after">
            <div id="missing_items" class="mt-4">
                <h4>Missing Items</h4>
                <t t-set="missing_order_lines" t-value="sale_order.order_line.filtered(lambda l: l.missing_items)"/>
                <t t-if="missing_order_lines">
                    <table class="table table-hover" style="font-size: 1.0em; line-height: 1.2;">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="missing_order_lines" t-as="line">
                                <tr>
                                    <td><t t-esc="line.product_id.display_name"/></td>
                                    <td><t t-esc="line.product_uom_qty"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <p>No missing items.</p>
                </t>
            </div>
        </xpath>

        <xpath expr="//t[@t-set='lines_to_report']" position="attributes">
            <attribute name="t-value">sale_order.order_line.filtered(lambda l: not l.missing_items)</attribute>
        </xpath>

        <xpath expr="//div[@id='total']" position="replace"/>

        <xpath expr="//h3[@id='details']" position="replace">
            <h3 id="details">Items</h3>
        </xpath>

    </template>
</odoo>